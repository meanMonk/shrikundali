# Frontend environment variables
# Copy to .env and edit. PUBLIC_* values are inlined at BUILD time
# (see Dockerfile.frontend + compose.yaml build args).

# Backend API URL (must be running for teaser/checkout to work)
VITE_API_URL=http://localhost:3400
PUBLIC_API_URL=http://localhost:3400

# Meta (Facebook) Pixel ID — leave empty to disable.
# Events: PageView, ViewContent, Lead, InitiateCheckout, AddPaymentInfo, Purchase
PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX) — leave empty to disable.
# Events: page_view, view_item, generate_lead, begin_checkout,
#         add_payment_info, purchase, file_download
PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion tracking (e.g. AW-XXXXXXXXXX).
# GOOGLE_ADS_ID enables the tag; the labels below map funnel events to
# specific conversion actions (copy from Google Ads > Goals > Conversions).
# The "label" is the part after the slash in AW-XXXXXXXXXX/AbC-D_efGh.
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_CHECKOUT_LABEL=
PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# Microsoft Clarity project ID — leave empty to disable.
PUBLIC_CLARITY_PROJECT_ID=

# Google Maps Platform API key (for birthplace autocomplete).
# If unset, falls back to Nominatim (OpenStreetMap) then static city table.
# Get key at: https://console.cloud.google.com/apis/credentials
PUBLIC_GOOGLE_MAPS_API_KEY=
