# Frontend environment variables
# Copy to .env and edit

# Backend API URL (must be running for teaser/checkout to work)
VITE_API_URL=http://localhost:3400

# Meta Pixel ID (for ad tracking — leave empty to disable)
PUBLIC_META_PIXEL_ID=

# Google Analytics Measurement ID (for analytics — leave empty to disable)
PUBLIC_GA_MEASUREMENT_ID=

# Google Maps Platform API key (for birthplace autocomplete).
# If unset, falls back to Nominatim (OpenStreetMap) then static city table.
# Get key at: https://console.cloud.google.com/apis/credentials
PUBLIC_GOOGLE_MAPS_API_KEY=
