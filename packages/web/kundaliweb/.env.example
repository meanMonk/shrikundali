# Frontend environment variables
# Copy to .env and edit

# Backend API URL
VITE_API_URL=http://localhost:3400

# Meta Pixel ID
PUBLIC_META_PIXEL_ID=

# Google Analytics Measurement ID
PUBLIC_GA_MEASUREMENT_ID=

# Google Maps Platform API key (Places Autocomplete for birthplace field).
# If unset, the birthplace field falls back to a debounced Nominatim (OpenStreetMap)
# lookup, then a small static city table as a last resort.
PUBLIC_GOOGLE_MAPS_API_KEY=
