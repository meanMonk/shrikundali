  <script>
    import { staticLookup, nominatimSearch, debounce, DEFAULT_COORDS } from "../lib/geocoding";
    import { checkoutAttribution } from "../lib/attribution";
    import {
      initTracking,
      trackLead,
      trackBeginCheckout,
      trackAddPaymentInfo,
      trackPurchaseOnce,
      trackDownload,
      trackCustom,
    } from "../lib/tracking";

    const trackingCtx = (window as any).__SK_TRACKING || {};
    const REPORT_TYPE: string = trackingCtx.reportType || "financial_kundali";
    const DUAL: boolean = !!trackingCtx.dual;
    initTracking({ angle: trackingCtx.angle, reportType: REPORT_TYPE });

    const API_URL = (import.meta as any).env?.VITE_API_URL ?? "http://localhost:3400";
    const GOOGLE_MAPS_API_KEY = (import.meta as any).env?.PUBLIC_GOOGLE_MAPS_API_KEY ?? "";

    let cacheId: string | null = null;
    let reportPrice: number | null = null;
    let reportOriginalPrice: number | null = null;
    let formName = "";
    let formGender = "";

    // ---- Blocking loading overlay: prevents leaving the page while we generate ----
    const loadingOverlay = document.getElementById("loading-overlay");
    const loadingOverlayTitle = document.getElementById("loading-overlay-title");
    const loadingOverlayText = document.getElementById("loading-overlay-text");
    const loadingOverlayBar = document.getElementById("loading-overlay-bar");
    let loadingActive = false;
    let reportGenerating = false;
    let loadingTimer: number | null = null;

    function showLoadingOverlay(title: string, messages: string[]) {
      if (!loadingOverlay) return;
      loadingActive = true;
      document.body.classList.add("sk-loading");
      if (loadingOverlayTitle) loadingOverlayTitle.textContent = title;
      if (loadingOverlayBar) loadingOverlayBar.style.width = "12%";
      let i = 0;
      if (loadingOverlayText) loadingOverlayText.textContent = messages[0] || "";
      if (loadingTimer) window.clearInterval(loadingTimer);
      if (messages.length > 1) {
        loadingTimer = window.setInterval(() => {
          i = (i + 1) % messages.length;
          if (loadingOverlayText) loadingOverlayText.textContent = messages[i];
        }, 2600);
      }
    }

    function hideLoadingOverlay() {
      loadingActive = false;
      document.body.classList.remove("sk-loading");
      if (loadingTimer) { window.clearInterval(loadingTimer); loadingTimer = null; }
      if (loadingOverlay) loadingOverlay.style.display = "none";
    }

    window.addEventListener("beforeunload", (e) => {
      if (!loadingActive && !reportGenerating) return;
      e.preventDefault();
      e.returnValue = "";
    });

    const DEFAULT_FEATURES = [
      "Personalized report from your exact birth chart",
      "Wealth, career & investment timing windows",
      "Dasha & Antardasha timeline for 10+ years",
      "Doshas and practical remedies",
      "Print-ready, mobile & WhatsApp friendly PDF",
      "Backup copy sent to your email",
    ];

    function renderFeatureLists(items: string[]) {
      const features = items && items.length ? items : DEFAULT_FEATURES;
      for (const id of ["modal-features-list", "success-features-list"]) {
        const el = document.getElementById(id);
        if (!el) continue;
        el.innerHTML = features
          .map(
            (f) =>
              `<li style="display:flex;align-items:flex-start;gap:0.4rem"><span style="color:var(--color-success);font-weight:700">&#10003;</span><span>${f}</span></li>`,
          )
          .join("");
      }
    }
    renderFeatureLists(DEFAULT_FEATURES);

    function formatINR(value: number | null | undefined): string {
      return value == null ? "" : `\u20B9${value}`;
    }

    // ---- Fetch config for price ----
    async function loadConfig() {
      try {
        const res = await fetch(`${API_URL}/api/config/${REPORT_TYPE}`);
        if (res.ok) {
          const cfg = await res.json();
          reportPrice = cfg.discountPrice || cfg.price || 499;
          reportOriginalPrice = cfg.price || null;
          const unlockBtn = document.getElementById("unlock-btn");
          if (unlockBtn) unlockBtn.textContent = `Unlock Full Report \u2014 \u20B9${reportPrice}`;
          const modalPrice = document.getElementById("modal-price");
          const modalOriginal = document.getElementById("modal-original-price");
          if (modalPrice) modalPrice.textContent = `\u20B9${reportPrice}`;
          if (modalOriginal && reportOriginalPrice && reportOriginalPrice > reportPrice) {
            modalOriginal.textContent = `\u20B9${reportOriginalPrice}`;
          } else if (modalOriginal) {
            modalOriginal.style.display = "none";
          }
          const modalPayBtn = document.getElementById("modal-pay-btn");
          if (modalPayBtn) modalPayBtn.textContent = `Pay \u20B9${reportPrice} Securely`;
          if (Array.isArray(cfg.features) && cfg.features.length) renderFeatureLists(cfg.features);
        }
      } catch {}
    }
    loadConfig();

    // ---- Date & time dropdowns ----
    const timeSelects = ["tob-hour", "tob-minute", "tob-ampm"]
      .map((id) => document.getElementById(id) as HTMLSelectElement | null)
      .filter((el): el is HTMLSelectElement => !!el);

    function setTime12(hour12: number, minute: number, ampm: "AM" | "PM") {
      const h = document.getElementById("tob-hour") as HTMLSelectElement | null;
      const m = document.getElementById("tob-minute") as HTMLSelectElement | null;
      const ap = document.getElementById("tob-ampm") as HTMLSelectElement | null;
      if (h) h.value = String(hour12).padStart(2, "0");
      if (m) m.value = String(minute).padStart(2, "0");
      if (ap) ap.value = ampm;
    }

    function readDateISO(): string {
      const d = (document.getElementById("dob-day") as HTMLSelectElement | null)?.value;
      const mo = (document.getElementById("dob-month") as HTMLSelectElement | null)?.value;
      const y = (document.getElementById("dob-year") as HTMLSelectElement | null)?.value;
      if (!d || !mo || !y) return "";
      return `${y}-${mo}-${d}`;
    }

    function readTime24(): string {
      const h = (document.getElementById("tob-hour") as HTMLSelectElement | null)?.value || "12";
      const m = (document.getElementById("tob-minute") as HTMLSelectElement | null)?.value || "00";
      const ap = (document.getElementById("tob-ampm") as HTMLSelectElement | null)?.value || "AM";
      let hour = parseInt(h, 10) % 12;
      if (ap === "PM") hour += 12;
      return `${String(hour).padStart(2, "0")}:${m.padStart(2, "0")}`;
    }

    // ---- Approx time checkbox ----
    const approxCheckbox = document.getElementById("approx-time") as HTMLInputElement | null;
    approxCheckbox?.addEventListener("change", () => {
      const disabled = !!approxCheckbox.checked;
      timeSelects.forEach((s) => { s.disabled = disabled; });
      if (disabled) setTime12(12, 0, "PM");
    });

    // ---- Birthplace geocoding ----
    const birthplaceInput = document.getElementById("birthplace") as HTMLInputElement | null;
    const coordinatesInput = document.getElementById("coordinates") as HTMLInputElement | null;
    const suggestionsBox = document.getElementById("place-suggestions") as HTMLDivElement | null;

    function setCoordinates(lat: number, lon: number) {
      if (coordinatesInput) coordinatesInput.value = `${lat.toFixed(4)},${lon.toFixed(4)}`;
    }

    if (GOOGLE_MAPS_API_KEY && birthplaceInput) {
      const initGooglePlaces = () => {
        const g = (window as any).google;
        if (!g?.maps?.places || !birthplaceInput) return;
        const autocomplete = new g.maps.places.Autocomplete(birthplaceInput, {
          types: ["(cities)"],
        });
        autocomplete.addListener("place_changed", () => {
          const place = autocomplete.getPlace();
          const loc = place?.geometry?.location;
          if (loc) setCoordinates(loc.lat(), loc.lng());
        });
      };
      if ((window as any).google?.maps?.places) initGooglePlaces();
      else window.addEventListener("load", initGooglePlaces);
    } else if (birthplaceInput) {
      const runSearch = debounce(async (query: string) => {
        if (!suggestionsBox) return;
        if (!query || query.trim().length < 3) { suggestionsBox.style.display = "none"; return; }
        try {
          const results = await nominatimSearch(query);
          suggestionsBox.innerHTML = "";
          if (results.length === 0) {
            const empty = document.createElement("div");
            empty.className = "place-empty";
            empty.textContent = "No matching place found — try a nearby city.";
            suggestionsBox.appendChild(empty);
            suggestionsBox.style.display = "block";
            return;
          }
          results.forEach((r) => {
            const parts = r.label.split(",").map((s) => s.trim()).filter(Boolean);
            const name = parts[0] || r.label;
            const region = parts.slice(1, 4).join(", ");
            const item = document.createElement("button");
            item.type = "button";
            item.className = "place-item";
            item.setAttribute("role", "option");
            const nameEl = document.createElement("span");
            nameEl.className = "place-item-name";
            nameEl.textContent = name;
            item.appendChild(nameEl);
            if (region) {
              const regionEl = document.createElement("span");
              regionEl.className = "place-item-region";
              regionEl.textContent = region;
              item.appendChild(regionEl);
            }
            item.addEventListener("click", () => {
              if (birthplaceInput) birthplaceInput.value = name;
              setCoordinates(r.lat, r.lon);
              suggestionsBox.style.display = "none";
            });
            suggestionsBox.appendChild(item);
          });
          suggestionsBox.style.display = "block";
        } catch {}
      }, 1000);

      birthplaceInput.addEventListener("input", () => {
        const query = birthplaceInput.value;
        const staticMatch = staticLookup(query);
        if (staticMatch) setCoordinates(staticMatch.lat, staticMatch.lon);
        else setCoordinates(DEFAULT_COORDS.lat, DEFAULT_COORDS.lon);
        runSearch(query);
      });

      document.addEventListener("click", (e) => {
        if (suggestionsBox && !suggestionsBox.contains(e.target as Node) && e.target !== birthplaceInput) {
          suggestionsBox.style.display = "none";
        }
      });
    }

    // ---- Partner fields (match_kundali only) ----
    const partnerTimeSelects = ["partner-tob-hour", "partner-tob-minute", "partner-tob-ampm"]
      .map((id) => document.getElementById(id) as HTMLSelectElement | null)
      .filter((el): el is HTMLSelectElement => !!el);

    function setPartnerTime12(hour12: number, minute: number, ampm: "AM" | "PM") {
      const h = document.getElementById("partner-tob-hour") as HTMLSelectElement | null;
      const m = document.getElementById("partner-tob-minute") as HTMLSelectElement | null;
      const ap = document.getElementById("partner-tob-ampm") as HTMLSelectElement | null;
      if (h) h.value = String(hour12).padStart(2, "0");
      if (m) m.value = String(minute).padStart(2, "0");
      if (ap) ap.value = ampm;
    }

    function readPartnerDateISO(): string {
      const d = (document.getElementById("partner-dob-day") as HTMLSelectElement | null)?.value;
      const mo = (document.getElementById("partner-dob-month") as HTMLSelectElement | null)?.value;
      const y = (document.getElementById("partner-dob-year") as HTMLSelectElement | null)?.value;
      if (!d || !mo || !y) return "";
      return `${y}-${mo}-${d}`;
    }

    function readPartnerTime24(): string {
      const h = (document.getElementById("partner-tob-hour") as HTMLSelectElement | null)?.value || "12";
      const m = (document.getElementById("partner-tob-minute") as HTMLSelectElement | null)?.value || "00";
      const ap = (document.getElementById("partner-tob-ampm") as HTMLSelectElement | null)?.value || "AM";
      let hour = parseInt(h, 10) % 12;
      if (ap === "PM") hour += 12;
      return `${String(hour).padStart(2, "0")}:${m.padStart(2, "0")}`;
    }

    const partnerApprox = document.getElementById("partner-approx-time") as HTMLInputElement | null;
    partnerApprox?.addEventListener("change", () => {
      const disabled = !!partnerApprox.checked;
      partnerTimeSelects.forEach((s) => { s.disabled = disabled; });
      if (disabled) setPartnerTime12(12, 0, "PM");
    });

    const partnerBirthplace = document.getElementById("partner-birthplace") as HTMLInputElement | null;
    const partnerCoordinates = document.getElementById("partner-coordinates") as HTMLInputElement | null;
    const partnerSuggestions = document.getElementById("partner-place-suggestions") as HTMLDivElement | null;

    function setPartnerCoordinates(lat: number, lon: number) {
      if (partnerCoordinates) partnerCoordinates.value = `${lat.toFixed(4)},${lon.toFixed(4)}`;
    }

    if (partnerBirthplace) {
      const runPartnerSearch = debounce(async (query: string) => {
        if (!partnerSuggestions) return;
        if (!query || query.trim().length < 3) { partnerSuggestions.style.display = "none"; return; }
        try {
          const results = await nominatimSearch(query);
          partnerSuggestions.innerHTML = "";
          if (results.length === 0) {
            const empty = document.createElement("div");
            empty.className = "place-empty";
            empty.textContent = "No matching place found — try a nearby city.";
            partnerSuggestions.appendChild(empty);
            partnerSuggestions.style.display = "block";
            return;
          }
          results.forEach((r) => {
            const parts = r.label.split(",").map((s) => s.trim()).filter(Boolean);
            const name = parts[0] || r.label;
            const region = parts.slice(1, 4).join(", ");
            const item = document.createElement("button");
            item.type = "button";
            item.className = "place-item";
            item.setAttribute("role", "option");
            const nameEl = document.createElement("span");
            nameEl.className = "place-item-name";
            nameEl.textContent = name;
            item.appendChild(nameEl);
            if (region) {
              const regionEl = document.createElement("span");
              regionEl.className = "place-item-region";
              regionEl.textContent = region;
              item.appendChild(regionEl);
            }
            item.addEventListener("click", () => {
              if (partnerBirthplace) partnerBirthplace.value = name;
              setPartnerCoordinates(r.lat, r.lon);
              partnerSuggestions.style.display = "none";
            });
            partnerSuggestions.appendChild(item);
          });
          partnerSuggestions.style.display = "block";
        } catch {}
      }, 1000);

      partnerBirthplace.addEventListener("input", () => {
        const q = partnerBirthplace.value;
        const m = staticLookup(q);
        if (m) setPartnerCoordinates(m.lat, m.lon);
        else setPartnerCoordinates(DEFAULT_COORDS.lat, DEFAULT_COORDS.lon);
        runPartnerSearch(q);
      });

      document.addEventListener("click", (e) => {
        if (partnerSuggestions && !partnerSuggestions.contains(e.target as Node) && e.target !== partnerBirthplace) {
          partnerSuggestions.style.display = "none";
        }
      });
    }

    // ---- Sticky mobile CTA on scroll ----
    const stickyCta = document.getElementById("sticky-cta");
    const formSection = document.getElementById("form-section");
    window.addEventListener("scroll", () => {
      if (!stickyCta || !formSection) return;
      const rect = formSection.getBoundingClientRect();
      const pastForm = rect.bottom < 0;
      stickyCta.style.display = pastForm && window.innerWidth < 768 ? "flex" : "none";
    });

    // ---- Form submit: call /teaser, show results on-page ----
    const form = document.getElementById("kundali-form") as HTMLFormElement | null;
    const statusEl = document.getElementById("form-status");
    const teaserResults = document.getElementById("teaser-results");
    const previewScores = document.getElementById("preview-scores");
    const submitBtn = document.getElementById("form-submit-btn") as HTMLButtonElement | null;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      formName = (document.getElementById("label") as HTMLInputElement).value;
      formGender = (document.getElementById("gender") as HTMLSelectElement).value;
      const dob = readDateISO();
      const birthtime = readTime24();
      const coordinates = coordinatesInput?.value || `${DEFAULT_COORDS.lat},${DEFAULT_COORDS.lon}`;
      const datetime = `${dob}T${birthtime}:00+05:30`;
      const lang = (document.getElementById("la") as HTMLSelectElement).value;

      let partner: Record<string, string> | undefined;
      if (DUAL) {
        const pDob = readPartnerDateISO();
        const pTime = readPartnerTime24();
        if (pDob) {
          partner = {
            name: (document.getElementById("partner-name") as HTMLInputElement | null)?.value || "",
            gender: (document.getElementById("partner-gender") as HTMLSelectElement | null)?.value || "",
            datetime: `${pDob}T${pTime}:00+05:30`,
            coordinates: partnerCoordinates?.value || `${DEFAULT_COORDS.lat},${DEFAULT_COORDS.lon}`,
            place: partnerBirthplace?.value || "",
          };
        } else {
          if (statusEl) { statusEl.textContent = "Please fill in your partner's birth details."; statusEl.style.color = "#c00"; }
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "Show My Free Preview"; }
          return;
        }
      }

      if (statusEl) { statusEl.textContent = ""; }
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = "Generating..."; }
      showLoadingOverlay("Generating your free preview\u2026", [
        "Reading your birth chart\u2026",
        "Calculating Lagna, Rashi & Nakshatra\u2026",
        "Checking doshas and yogas\u2026",
        "Almost there\u2026",
      ]);

      try {
        const res = await fetch(`${API_URL}/teaser`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reportType: REPORT_TYPE, name: formName, gender: formGender, datetime, coordinates, ayanamsa: 1, la: lang, place: (document.getElementById("birthplace") as HTMLInputElement | null)?.value || "", email: `preview-${Date.now()}@rashikundali.com`, attribution: checkoutAttribution(), partner }),
        });
        if (!res.ok) throw new Error(`Teaser request failed (${res.status})`);
        const data = await res.json();
        cacheId = data.cacheId;
        trackLead({ content_name: `${REPORT_TYPE}_preview`, form_name: formName, gender: formGender });

        // Show teaser results on-page
        const t = data.teaser || {};
        const setTxt = (id: string, val: string) => { const el = document.getElementById(id); if (el) el.textContent = val || "\u2014"; };
        const lagna = t.lagna; setTxt("preview-lagna", typeof lagna === "object" ? lagna?.name : lagna);
        const rashi = t.rashi; setTxt("preview-rashi", typeof rashi === "object" ? rashi?.name : rashi);
        const nakshatra = t.nakshatra; setTxt("preview-nakshatra", typeof nakshatra === "object" ? nakshatra?.name : nakshatra);
        setTxt("preview-dosha", t.mangalDosha ? "Mangal" : t.doshaFlag || t.dosha || "None");

        // Financial money-axis preview (only present for financial_kundali)
        const scores = t.moneyAxisScores;
        if (scores) {
          const setScore = (id: string, v: number) => {
            const el = document.getElementById(id);
            if (el) el.textContent = typeof v === "number" ? `${v}/10` : "--";
          };
          setScore("preview-score-wealth", scores.wealthPotential);
          setScore("preview-score-career", scores.careerGrowth);
          setScore("preview-score-business", scores.businessLuck);
          setScore("preview-score-property", scores.propertyAssets);
          setScore("preview-score-invest", scores.investmentSense);
          setScore("preview-score-stability", scores.financialStability);
          const vals = [scores.wealthPotential, scores.careerGrowth, scores.businessLuck, scores.propertyAssets, scores.investmentSense, scores.financialStability].filter((n) => typeof n === "number");
          const avg = vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : 0;
          const bar = document.getElementById("preview-score-bar");
          if (bar) bar.style.width = `${Math.round((avg / 10) * 100)}%`;
          if (previewScores) previewScores.style.display = "block";
        } else if (previewScores) {
          previewScores.style.display = "none";
        }

        // Match Kundali compatibility preview (only present for match_kundali)
        const matching = t.matching;
        const previewMatching = document.getElementById("preview-matching");
        if (matching && previewMatching) {
          setTxt("preview-match-score", String(matching.totalPoints ?? "--"));
          setTxt("preview-match-band", matching.band || "");
          setTxt("preview-match-note", matching.recommendation || "");
          previewMatching.style.display = "block";
        } else if (previewMatching) {
          previewMatching.style.display = "none";
        }

        if (teaserResults) teaserResults.style.display = "block";
        if (statusEl) statusEl.textContent = "";
        trackCustom("teaser_viewed", { cache_id: cacheId });

        // Scroll to teaser results
        teaserResults?.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch (err) {
        if (statusEl) { statusEl.textContent = "Something went wrong. Please try again."; statusEl.style.color = "#c00"; }
        console.error("Teaser submission failed:", err);
      } finally {
        hideLoadingOverlay();
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = "Show My Free Preview"; }
      }
    });

    // ---- Unlock button: open payment modal ----
    const modal = document.getElementById("payment-modal") as HTMLDivElement;
    const modalEmail = document.getElementById("modal-email") as HTMLInputElement;
    const modalClose = document.getElementById("modal-close");

    document.getElementById("unlock-btn")?.addEventListener("click", () => {
      if (!cacheId) { alert("Please submit the form first."); return; }
      modal.style.display = "flex";
      if (modalEmail) modalEmail.focus();
      trackBeginCheckout({ value: reportPrice, currency: "INR" });
    });

    modalClose?.addEventListener("click", () => { modal.style.display = "none"; });
    modal?.addEventListener("click", (e) => { if (e.target === modal) modal.style.display = "none"; });

    // ---- Post-payment: verify, generate, then download directly in the browser ----
    const successModal = document.getElementById("success-modal") as HTMLDivElement | null;
    const successStatus = document.getElementById("success-status");
    const successDownloadBtn = document.getElementById("success-download-btn") as HTMLButtonElement | null;

    // While the report is generating the success dialog is non-dismissable so the
    // user can't navigate away mid-generation.
    let successBlocking = false;
    function setSuccessBlocking(on: boolean) {
      successBlocking = on;
      reportGenerating = on;
      const closeBtn = document.getElementById("success-close") as HTMLElement | null;
      if (closeBtn) closeBtn.style.display = on ? "none" : "block";
    }

    function setSuccessStatus(text: string, kind: "info" | "error" | "ok" = "info") {
      if (!successStatus) return;
      if (!text) { successStatus.style.display = "none"; successStatus.textContent = ""; return; }
      successStatus.style.display = "block";
      successStatus.textContent = text;
      successStatus.style.background = kind === "error" ? "#fee" : kind === "ok" ? "#e7f6ec" : "#eef2ff";
      successStatus.style.color = kind === "error" ? "#c00" : kind === "ok" ? "#1a7f37" : "#334";
    }

    function setSuccessProgress(text: string | null, showSpinner = false) {
      const row = document.getElementById("success-progress");
      const label = document.getElementById("success-progress-text");
      const spinner = document.getElementById("success-spinner");
      if (row) row.style.display = text ? "flex" : "none";
      if (label) label.textContent = text || "";
      if (spinner) spinner.style.display = showSpinner ? "inline-block" : "none";
    }

    function setDownloadButton(mode: "preparing" | "ready" | "retry", label?: string) {
      if (!successDownloadBtn) return;
      successDownloadBtn.disabled = mode === "preparing";
      successDownloadBtn.style.opacity = mode === "preparing" ? "0.7" : "1";
      successDownloadBtn.style.cursor = mode === "preparing" ? "default" : "pointer";
      successDownloadBtn.textContent =
        label || (mode === "ready" ? "Download PDF" : mode === "retry" ? "Retry download" : "Preparing your report\u2026");
    }

    function openSuccessModal(info: { orderId: string; amount?: number | null; email?: string }) {
      if (!successModal) return;
      const orderEl = document.getElementById("success-order");
      const amountEl = document.getElementById("success-amount");
      const emailEl = document.getElementById("success-email");
      if (orderEl) orderEl.textContent = info.orderId;
      if (amountEl) amountEl.textContent = formatINR(info.amount) || "\u2014";
      if (emailEl) emailEl.textContent = info.email || "\u2014";
      successModal.style.display = "flex";
    }

    function triggerBlobDownload(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    async function getOrderStatus(orderId: string): Promise<any | null> {
      try {
        const res = await fetch(`${API_URL}/payment/order/${orderId}`);
        if (!res.ok) return null;
        return await res.json();
      } catch {
        return null;
      }
    }

    async function downloadReportFile(orderId: string): Promise<boolean> {
      const res = await fetch(`${API_URL}/payment/download/${orderId}`);
      if (!res.ok) return false;
      const blob = await res.blob();
      if (!blob || blob.size === 0) return false;
      triggerBlobDownload(blob, `kundali-report-${orderId}.pdf`);
      trackDownload({ transaction_id: orderId, content_ids: [orderId] });
      return true;
    }

    // Poll the order until the (server-side, self-healing) report is ready.
    async function waitForReport(orderId: string, attempts = 24, delayMs = 2500) {
      for (let i = 0; i < attempts; i++) {
        const d = await getOrderStatus(orderId);
        if (d?.archiveId) return d;
        await new Promise((r) => setTimeout(r, delayMs));
      }
      return null;
    }

    async function finishDownload(orderId: string) {
      setSuccessProgress("Downloading your PDF\u2026", true);
      setDownloadButton("preparing", "Downloading\u2026");
      const ok = await downloadReportFile(orderId).catch(() => false);
      setSuccessProgress(null);
      if (ok) {
        setDownloadButton("ready");
        setSuccessStatus("Downloaded \u2014 a backup copy has been emailed to you.", "ok");
      } else {
        setDownloadButton("retry");
        setSuccessStatus("Couldn't download automatically. Tap retry, or use the link in your email.", "error");
      }
    }

    async function completePayment(
      orderId: string,
      verify: { paymentId?: string; signature?: string },
      email: string,
    ) {
      if (modal) modal.style.display = "none";
      openSuccessModal({ orderId, amount: reportPrice, email });
      setSuccessBlocking(true);
      setSuccessStatus("");
      setDownloadButton("preparing");
      setSuccessProgress("Confirming your payment\u2026 please keep this page open.", true);

      if (successDownloadBtn) {
        successDownloadBtn.onclick = () => { void finishDownload(orderId); };
      }

      // 1) Verify the signature (client callback) and generate immediately.
      let info: any = null;
      if (verify.paymentId && verify.signature) {
        try {
          const res = await fetch(`${API_URL}/payment/verify`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              orderId,
              cacheId,
              provider: "razorpay",
              paymentId: verify.paymentId,
              signature: verify.signature,
            }),
          });
          if (res.ok) {
            info = await res.json();
            openSuccessModal({ orderId, amount: info.amount, email: info.email || email });
          }
        } catch {}
      }

      // 2) Otherwise poll — the server re-confirms payment and self-heals.
      if (!info?.archiveId) {
        setSuccessProgress("Generating your report\u2026 please keep this page open (under a minute).", true);
        info = await waitForReport(orderId);
      }

      if (!info?.archiveId) {
        setSuccessBlocking(false);
        setSuccessProgress(null);
        setDownloadButton("retry");
        setSuccessStatus("Your report is still being prepared. Tap retry in a moment \u2014 a download link is also emailed to you.", "error");
        return;
      }

      trackPurchaseOnce(orderId, {
        value: info.amount ?? reportPrice,
        currency: "INR",
        content_type: "product",
      });

      setSuccessBlocking(false);
      await finishDownload(orderId);
    }

    document.getElementById("success-close")?.addEventListener("click", () => { if (!successBlocking && successModal) successModal.style.display = "none"; });
    successModal?.addEventListener("click", (e) => { if (!successBlocking && e.target === successModal) successModal.style.display = "none"; });

    // ---- Modal payment: call /payment/checkout + Razorpay ----
    const modalForm = document.getElementById("modal-payment-form") as HTMLFormElement;
    const modalPayBtn = document.getElementById("modal-pay-btn") as HTMLButtonElement;
    const modalStatus = document.getElementById("modal-status");

    modalForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!cacheId) return;
      const email = modalEmail.value;
      if (!email) return;

      modalPayBtn.disabled = true;
      modalPayBtn.textContent = "Processing...";
      if (modalStatus) { modalStatus.style.display = "none"; }

      trackAddPaymentInfo({ value: reportPrice, currency: "INR" });

      try {
        const res = await fetch(`${API_URL}/payment/checkout`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cacheId, provider: "razorpay", email, name: formName, attribution: checkoutAttribution() }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: "Failed" }));
          if (modalStatus) { modalStatus.style.display = "block"; modalStatus.style.background = "#fee"; modalStatus.style.color = "#c00"; modalStatus.textContent = err.error || "Payment failed. Please try again."; }
          modalPayBtn.disabled = false;
          modalPayBtn.textContent = `Pay \u20B9${reportPrice || ""} Securely`;
          return;
        }

        const data = await res.json();
        trackCustom("payment_order_created", { order_id: data.orderId, value: data.amount, currency: data.currency });

        if (data.key) {
          const options = {
            key: data.key,
            amount: data.amount * 100,
            currency: data.currency,
            name: "Rashi Kundali",
            description: "Kundali Report",
            order_id: data.orderId,
            handler: function (response: any) {
              completePayment(
                data.orderId,
                { paymentId: response?.razorpay_payment_id, signature: response?.razorpay_signature },
                email,
              );
            },
            prefill: { email },
            theme: { color: "#B5451C" },
          };
          const rzp = new (window as any).Razorpay(options);
          rzp.on("payment.failed", function () {
            if (modalStatus) { modalStatus.style.display = "block"; modalStatus.style.background = "#fee"; modalStatus.style.color = "#c00"; modalStatus.textContent = "Payment failed. Please try again."; }
            modalPayBtn.disabled = false;
            modalPayBtn.textContent = `Pay \u20B9${reportPrice || ""} Securely`;
          });
          rzp.open();
        } else if (data.checkoutUrl) {
          window.location.href = data.checkoutUrl;
        } else {
          if (modalStatus) { modalStatus.style.display = "block"; modalStatus.style.background = "#efe"; modalStatus.style.color = "#060"; modalStatus.textContent = `Order created: ${data.orderId}. Check your email for payment link.`; }
          modalPayBtn.disabled = false;
          modalPayBtn.textContent = `Pay \u20B9${reportPrice || ""} Securely`;
        }
      } catch (err: any) {
        if (modalStatus) { modalStatus.style.display = "block"; modalStatus.style.background = "#fee"; modalStatus.style.color = "#c00"; modalStatus.textContent = `Error: ${err.message}`; }
        modalPayBtn.disabled = false;
        modalPayBtn.textContent = `Pay \u20B9${reportPrice || ""} Securely`;
      }
    });
  </script>
  <script src="https://checkout.razorpay.com/v1/checkout.js" async></script>
</Base>
