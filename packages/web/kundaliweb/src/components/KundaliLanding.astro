---
import Base from "../layouts/Base.astro";
import { Lock, Sparkles, CheckCircle2, Phone, Mail, Star, Clock } from "@lucide/astro";

export interface Props {
  headline: string;
  subheadline: string;
  angleCopy: string;
  seoTitle: string;
  seoDescription: string;
  heroImageSrc?: string;
  pageCount?: string;
  features?: string[];
  aboutCopy?: string;
  angle?: string;
  reportType?: string;
  dual?: boolean;
  formHeading?: string;
  formSubheading?: string;
}

const {
  headline,
  subheadline,
  angleCopy,
  seoTitle,
  seoDescription,
  heroImageSrc = "/images/hero-kundali.svg",
  pageCount = "40+",
  angle = "money",
  reportType = "financial_kundali",
  dual = false,
  formHeading = "Get My Free Kundali Preview",
  formSubheading = "Fill your birth details below — takes under 60 seconds.",
  features = [
    "Full Vedic birth chart (Rasi & Navamsa) with planetary positions",
    "Detailed analysis of all 12 houses of life",
    "Dasha & Antardasha timeline for the next 10+ years",
    "Doshas identified — Mangal, Kaal Sarp, Sade Sati — with remedies",
    "Yogas present in your chart and how they shape your life",
    "Personalized predictions in simple, easy-to-understand language",
    "Auspicious dates (muhurat) for key decisions",
    "Downloadable PDF you can keep and revisit anytime",
  ],
  aboutCopy = "Every report is generated from your exact date, time and place of birth using the Lahiri ayanamsa — the sidereal system followed by traditional Vedic astrologers across India. We combine precise ephemeris calculations with time-tested classical texts (Parashari and Jaimini principles) to produce a report that's as rigorous as a hand-cast chart, delivered in minutes instead of days.",
} = Astro.props;

const API_URL = import.meta.env.VITE_API_URL ?? "http://localhost:3400";
const GOOGLE_MAPS_API_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? "";

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const DAYS = Array.from({ length: 31 }, (_, i) => i + 1);
const THIS_YEAR = new Date().getFullYear();
const YEARS = Array.from({ length: THIS_YEAR - 1919 }, (_, i) => THIS_YEAR - i);
const HOURS = Array.from({ length: 12 }, (_, i) => i + 1);
const MINUTES = Array.from({ length: 60 }, (_, i) => i);
const pad2 = (n: number) => String(n).padStart(2, "0");
---
<Base title={seoTitle} description={seoDescription}>
  <script is:inline set:html={`window.__SK_TRACKING=${JSON.stringify({ angle, reportType, dual })};`} />

  {GOOGLE_MAPS_API_KEY && (
    <script
      is:inline
      src={`https://maps.googleapis.com/maps/api/js?key=${GOOGLE_MAPS_API_KEY}&libraries=places&loading=async`}
      async
      defer
    ></script>
  )}

  <!-- Hero -->
  <section
    class="hero fade-in"
    style={`text-align:center;padding:3rem 1.5rem;border-radius:16px;margin-bottom:1.5rem;background-image:linear-gradient(180deg, rgba(36,30,78,0.82) 0%, rgba(181,69,28,0.72) 55%, rgba(251,246,239,0.9) 100%), url(${heroImageSrc});background-size:cover;background-position:center`}
  >
    <h1 class="hero-title" style="font-size:2rem;color:#fff;margin-bottom:0.75rem;line-height:1.3;text-shadow:0 2px 8px rgba(0,0,0,0.35)">
      {headline}
    </h1>
    <p class="hero-sub" style="font-size:1.1rem;color:#fff;opacity:0.95;margin-bottom:0.5rem;max-width:560px;margin-left:auto;margin-right:auto;text-shadow:0 1px 6px rgba(0,0,0,0.3)">
      {subheadline}
    </p>
    <p style="font-size:0.95rem;color:#fff;opacity:0.9;max-width:600px;margin:0 auto 1rem">{angleCopy}</p>
    <a href="#form-section" class="cta-pulse" style="display:inline-flex;align-items:center;gap:0.4rem;background:var(--color-gold);color:var(--color-secondary);padding:0.9rem 1.75rem;border-radius:8px;font-size:1.05rem;font-weight:700;text-decoration:none;min-height:44px">
      <Sparkles size={20} /> Get My Kundli Report
    </a>
  </section>

  <!-- Trust / feature strip -->
  <section class="fade-in" style="background:#fff;border:1px solid var(--color-border);border-radius:12px;padding:1.5rem;margin:1.5rem 0">
    <div class="grid-2" style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem">
      <div style="display:flex;align-items:start;gap:0.5rem;padding:0.75rem;background:var(--color-bg);border-radius:8px">
        <Lock size={22} color="var(--color-primary)" />
        <div>
          <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">Private &amp; Secure</h3>
          <p style="font-size:0.8rem;color:var(--color-text-muted)">Your birth data stays confidential</p>
        </div>
      </div>
      <div style="display:flex;align-items:start;gap:0.5rem;padding:0.75rem;background:var(--color-bg);border-radius:8px">
        <CheckCircle2 size={22} color="var(--color-primary)" />
        <div>
          <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">Vedic Accuracy</h3>
          <p style="font-size:0.8rem;color:var(--color-text-muted)">Lahiri ayanamsa, precise ephemeris</p>
        </div>
      </div>
      <div style="display:flex;align-items:start;gap:0.5rem;padding:0.75rem;background:var(--color-bg);border-radius:8px">
        <Clock size={22} color="var(--color-primary)" />
        <div>
          <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">PDF in 24&ndash;48h</h3>
          <p style="font-size:0.8rem;color:var(--color-text-muted)">Delivered to your email</p>
        </div>
      </div>
      <div style="display:flex;align-items:start;gap:0.5rem;padding:0.75rem;background:var(--color-bg);border-radius:8px">
        <Star size={22} color="var(--color-primary)" />
        <div>
          <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">Trusted by Thousands</h3>
          <p style="font-size:0.8rem;color:var(--color-text-muted)">Loved across India</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Report stats / trust badges -->
  <section class="fade-in" style="display:flex;flex-wrap:wrap;justify-content:center;gap:1.5rem;text-align:center;margin:2rem 0;padding:1.25rem;background:var(--color-secondary);border-radius:12px;color:#fff">
    <div>
      <div style="font-family:var(--font-heading);font-size:1.6rem;font-weight:700;color:var(--color-gold)">{pageCount}</div>
      <div style="font-size:0.8rem;opacity:0.85">Page Report</div>
    </div>
    <div>
      <div style="font-family:var(--font-heading);font-size:1.6rem;font-weight:700;color:var(--color-gold)">10+ yrs</div>
      <div style="font-size:0.8rem;opacity:0.85">Dasha Timeline Covered</div>
    </div>
    <div>
      <div style="font-family:var(--font-heading);font-size:1.6rem;font-weight:700;color:var(--color-gold)">Lahiri</div>
      <div style="font-size:0.8rem;opacity:0.85">Ayanamsa (Vedic Sidereal)</div>
    </div>
    <div>
      <div style="font-family:var(--font-heading);font-size:1.6rem;font-weight:700;color:var(--color-gold)">~2 min</div>
      <div style="font-size:0.8rem;opacity:0.85">Delivery After Payment</div>
    </div>
  </section>

  <!-- What's inside -->
  <section class="fade-in" style="margin:2rem 0">
    <h2 style="color:var(--color-primary);font-size:1.3rem;margin-bottom:0.35rem;text-align:center">What's Inside Your Report</h2>
    <p style="text-align:center;color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1.25rem;max-width:560px;margin-left:auto;margin-right:auto">A {pageCount}-page, software-generated report built on your exact birth details — no generic templates.</p>
    <ul style="list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;max-width:820px;margin:0 auto">
      {features.map((feature) => (
        <li style="display:flex;align-items:start;gap:0.5rem;background:#fff;border:1px solid var(--color-border);border-radius:8px;padding:0.75rem 1rem;font-size:0.9rem">
          <CheckCircle2 size={18} color="var(--color-success)" style="flex-shrink:0;margin-top:0.15rem" />
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Methodology / About -->
  <section class="fade-in" style="background:#fff;border:1px solid var(--color-border);border-radius:12px;padding:1.5rem;margin:2rem 0;max-width:820px;margin-left:auto;margin-right:auto">
    <h2 style="color:var(--color-primary);font-size:1.3rem;margin-bottom:0.75rem;text-align:center">How Your Report Is Prepared</h2>
    <p style="font-size:0.95rem;color:var(--color-text-muted);text-align:center;line-height:1.7">{aboutCopy}</p>
  </section>

  <!-- Teaser Form -->
  <section id="form-section" style="background:#fff;border:2px solid var(--color-primary);border-radius:12px;padding:2rem;margin:2rem 0">
    <h2 style="color:var(--color-primary);font-size:1.3rem;margin-bottom:0.5rem;text-align:center">{formHeading}</h2>
    <p style="text-align:center;color:var(--color-text-muted);font-size:0.9rem;margin-bottom:1rem">{formSubheading}</p>

    <form id="kundali-form" class={dual ? "kundali-form dual" : "kundali-form"} style={dual ? "max-width:960px;margin:0 auto" : "max-width:600px;margin:0 auto"}>
      <div class="person-card">
        {dual && <p class="person-card-title">Your Details</p>}
      <label class="field-label">
        <span>Your Name</span>
        <input type="text" id="label" name="label" placeholder="Your name" required class="field-input" />
        <span class="field-hint">This appears as the title on your report.</span>
      </label>

      <label class="field-label">
        <span>Gender</span>
        <select id="gender" name="gender" required class="field-input">
          <option value="" disabled selected>Select</option>
          <option value="male">Male</option>
          <option value="female">Female</option>
          <option value="other">Other</option>
        </select>
      </label>

      <div class="field-row">
        <div class="field-label">
          <span>Date of Birth</span>
          <div class="select-group dob-group">
            <select id="dob-day" class="field-input" aria-label="Day of birth" required>
              <option value="" disabled selected>Day</option>
              {DAYS.map((d) => <option value={pad2(d)}>{d}</option>)}
            </select>
            <select id="dob-month" class="field-input" aria-label="Month of birth" required>
              <option value="" disabled selected>Month</option>
              {MONTHS.map((m, i) => <option value={pad2(i + 1)}>{m}</option>)}
            </select>
            <select id="dob-year" class="field-input" aria-label="Year of birth" required>
              <option value="" disabled selected>Year</option>
              {YEARS.map((y) => <option value={String(y)}>{y}</option>)}
            </select>
          </div>
        </div>
        <div class="field-label">
          <span>Time of Birth</span>
          <div class="select-group time-group">
            <select id="tob-hour" class="field-input" aria-label="Hour of birth">
              {HOURS.map((h) => <option value={pad2(h)} selected={h === 12}>{h}</option>)}
            </select>
            <select id="tob-minute" class="field-input" aria-label="Minute of birth">
              {MINUTES.map((m) => <option value={pad2(m)} selected={m === 0}>{pad2(m)}</option>)}
            </select>
            <select id="tob-ampm" class="field-input" aria-label="AM or PM">
              <option value="AM">AM</option>
              <option value="PM" selected>PM</option>
            </select>
          </div>
        </div>
      </div>
      <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.85rem;color:var(--color-text-muted);margin:0.5rem 0 0.75rem">
        <input type="checkbox" id="approx-time" style="width:20px;height:20px" />
        I don't know the exact time (use 12:00 PM)
      </label>

      <div class="field-label">
        <label for="birthplace"><span>Birthplace</span></label>
        <div class="place-wrap">
          <input type="text" id="birthplace" name="birthplace" placeholder="City, State" required autocomplete="off" class="field-input" />
          <div id="place-suggestions" class="place-suggestions" role="listbox" aria-label="Birthplace suggestions"></div>
        </div>
        <span class="field-hint">Type your city — we'll match it automatically.</span>
        <input type="hidden" id="coordinates" value="19.0760,72.8777" />
      </div>
      </div>

      {dual && (
        <div id="partner-fields" class="person-card">
          <p class="person-card-title">Partner's Details</p>
          <label class="field-label">
            <span>Partner's Name</span>
            <input type="text" id="partner-name" name="partner-name" placeholder="Partner's name" class="field-input" />
          </label>
          <label class="field-label">
            <span>Partner's Gender</span>
            <select id="partner-gender" name="partner-gender" class="field-input">
              <option value="" disabled selected>Select</option>
              <option value="female">Female</option>
              <option value="male">Male</option>
              <option value="other">Other</option>
            </select>
          </label>
          <div class="field-row">
            <div class="field-label">
              <span>Partner's Date of Birth</span>
              <div class="select-group dob-group">
                <select id="partner-dob-day" class="field-input" aria-label="Partner's day of birth">
                  <option value="" disabled selected>Day</option>
                  {DAYS.map((d) => <option value={pad2(d)}>{d}</option>)}
                </select>
                <select id="partner-dob-month" class="field-input" aria-label="Partner's month of birth">
                  <option value="" disabled selected>Month</option>
                  {MONTHS.map((m, i) => <option value={pad2(i + 1)}>{m}</option>)}
                </select>
                <select id="partner-dob-year" class="field-input" aria-label="Partner's year of birth">
                  <option value="" disabled selected>Year</option>
                  {YEARS.map((y) => <option value={String(y)}>{y}</option>)}
                </select>
              </div>
            </div>
            <div class="field-label">
              <span>Partner's Time of Birth</span>
              <div class="select-group time-group">
                <select id="partner-tob-hour" class="field-input" aria-label="Partner's hour of birth">
                  {HOURS.map((h) => <option value={pad2(h)} selected={h === 12}>{h}</option>)}
                </select>
                <select id="partner-tob-minute" class="field-input" aria-label="Partner's minute of birth">
                  {MINUTES.map((m) => <option value={pad2(m)} selected={m === 0}>{pad2(m)}</option>)}
                </select>
                <select id="partner-tob-ampm" class="field-input" aria-label="Partner's AM or PM">
                  <option value="AM">AM</option>
                  <option value="PM" selected>PM</option>
                </select>
              </div>
            </div>
          </div>
          <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.85rem;color:var(--color-text-muted);margin:0.5rem 0 0.75rem">
            <input type="checkbox" id="partner-approx-time" style="width:20px;height:20px" />
            Partner's exact time is unknown (use 12:00 PM)
          </label>
          <div class="field-label">
            <label for="partner-birthplace"><span>Partner's Birthplace</span></label>
            <div class="place-wrap">
              <input type="text" id="partner-birthplace" name="partner-birthplace" placeholder="City, State" autocomplete="off" class="field-input" />
              <div id="partner-place-suggestions" class="place-suggestions" role="listbox" aria-label="Partner's birthplace suggestions"></div>
            </div>
            <input type="hidden" id="partner-coordinates" value="19.0760,72.8777" />
          </div>
        </div>
      )}

      <div class="form-common">
      <label class="field-label">
        <span>Report Language</span>
        <select id="la" name="la" class="field-input">
          <option value="en" selected>English</option>
          <option value="hi">Hindi</option>
        </select>
      </label>

      <input type="hidden" id="ayanamsa" value="1" />

      <p style="font-size:0.8rem;color:var(--color-success);margin-bottom:1rem;text-align:center">&#x1F512; Your birth details are encrypted and never shared.</p>

      <button type="submit" id="form-submit-btn" class="cta-pulse" style="width:100%;min-height:44px;background:var(--color-primary);color:#fff;border:none;border-radius:8px;font-size:1.05rem;font-weight:700;cursor:pointer">
        Show My Free Preview
      </button>
      </div>
    </form>

    <p id="form-status" style="text-align:center;margin-top:1rem;font-size:0.9rem"></p>

    <!-- Teaser results (hidden until API response) -->
    <div id="teaser-results" style="display:none;margin-top:1.5rem;background:var(--color-bg);border:1px solid var(--color-border);border-radius:8px;padding:1.25rem;text-align:center">
      <p style="font-size:0.85rem;color:var(--color-secondary);font-weight:600;margin-bottom:0.75rem">Your Free Preview</p>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.5rem;max-width:400px;margin:0 auto">
        <div><div style="font-size:0.7rem;color:var(--color-text-muted)">Lagna</div><div id="preview-lagna" style="font-weight:700;color:var(--color-primary)">&mdash;</div></div>
        <div><div style="font-size:0.7rem;color:var(--color-text-muted)">Rashi</div><div id="preview-rashi" style="font-weight:700;color:var(--color-primary)">&mdash;</div></div>
        <div><div style="font-size:0.7rem;color:var(--color-text-muted)">Nakshatra</div><div id="preview-nakshatra" style="font-weight:700;color:var(--color-primary)">&mdash;</div></div>
        <div><div style="font-size:0.7rem;color:var(--color-text-muted)">Dosha</div><div id="preview-dosha" style="font-weight:700;color:var(--color-primary)">&mdash;</div></div>
      </div>
      <div id="preview-scores" style="display:none;margin:1rem auto 0;max-width:420px;text-align:left">
        <p style="font-size:0.72rem;color:var(--color-text-muted);font-weight:600;text-align:center;margin-bottom:0.5rem">Financial Money-Axis Preview</p>
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:0.35rem 0.9rem;font-size:0.78rem;color:var(--color-text-muted)">
          <div style="display:flex;justify-content:space-between"><span>Wealth</span><strong id="preview-score-wealth" style="color:var(--color-primary)">--</strong></div>
          <div style="display:flex;justify-content:space-between"><span>Career</span><strong id="preview-score-career" style="color:var(--color-primary)">--</strong></div>
          <div style="display:flex;justify-content:space-between"><span>Business</span><strong id="preview-score-business" style="color:var(--color-primary)">--</strong></div>
          <div style="display:flex;justify-content:space-between"><span>Property</span><strong id="preview-score-property" style="color:var(--color-primary)">--</strong></div>
          <div style="display:flex;justify-content:space-between"><span>Investment</span><strong id="preview-score-invest" style="color:var(--color-primary)">--</strong></div>
          <div style="display:flex;justify-content:space-between"><span>Stability</span><strong id="preview-score-stability" style="color:var(--color-primary)">--</strong></div>
        </div>
        <div style="margin-top:0.6rem;height:6px;border-radius:4px;background:var(--color-border);overflow:hidden"><div id="preview-score-bar" style="height:100%;width:0%;background:var(--color-primary);transition:width .6s ease"></div></div>
        <p style="font-size:0.68rem;color:var(--color-text-muted);text-align:center;margin-top:0.35rem">Overall financial strength</p>
      </div>
      <div id="preview-matching" style="display:none;margin:1rem auto 0;max-width:420px;text-align:center">
        <p style="font-size:0.72rem;color:var(--color-text-muted);font-weight:600;margin-bottom:0.35rem">Guna Milan Compatibility</p>
        <div style="font-family:var(--font-heading);font-size:1.8rem;font-weight:700;color:var(--color-primary)"><span id="preview-match-score">--</span><span style="font-size:0.9rem;color:var(--color-text-muted)">/36</span></div>
        <div id="preview-match-band" style="font-size:0.85rem;font-weight:600;color:var(--color-secondary)"></div>
        <p id="preview-match-note" style="font-size:0.72rem;color:var(--color-text-muted);margin-top:0.35rem"></p>
      </div>

      <p style="font-size:0.75rem;color:var(--color-text-muted);margin-top:0.75rem">Unlock below for your full detailed Kundali PDF.</p>
      <button id="unlock-btn" type="button" class="cta-pulse" style="margin-top:1rem;min-height:44px;background:var(--color-primary);color:#fff;border:none;border-radius:8px;padding:0.85rem 2rem;font-size:1.05rem;font-weight:700;cursor:pointer">
        Unlock Full Report
      </button>
      <p style="font-size:0.7rem;color:var(--color-text-muted);margin-top:0.5rem">&#x1F512; Secure payment &bull; Private &bull; Delivered in 24&ndash;48 hours</p>
    </div>
  </section>

  <!-- Payment Modal -->
  <div id="payment-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:200;align-items:center;justify-content:center;padding:1rem">
    <div style="background:#fff;border-radius:12px;padding:1.75rem;max-width:420px;width:100%;position:relative">
      <button id="modal-close" type="button" style="position:absolute;top:0.75rem;right:0.75rem;background:none;border:none;font-size:1.5rem;cursor:pointer;color:var(--color-text-muted)">&times;</button>
      <h3 style="color:var(--color-primary);font-size:1.15rem;text-align:center;margin-bottom:1rem">Unlock Your Full Kundli Report</h3>
      <div style="text-align:center;margin-bottom:1rem">
        <span id="modal-original-price" style="font-size:1rem;color:var(--color-text-muted);text-decoration:line-through;margin-right:0.5rem"></span>
        <span id="modal-price" style="font-size:1.5rem;font-weight:700;color:var(--color-primary)"></span>
      </div>
      <div style="background:var(--color-bg);border:1px solid var(--color-border);border-radius:8px;padding:0.75rem 1rem;margin-bottom:1rem;text-align:left">
        <p style="font-size:0.8rem;font-weight:600;color:var(--color-secondary);margin-bottom:0.4rem">What you get:</p>
        <ul id="modal-features-list" style="list-style:none;display:grid;gap:0.3rem;font-size:0.82rem;color:var(--color-text-muted)"></ul>
      </div>
      <form id="modal-payment-form">
        <label class="field-label">
          <span>Email Address</span>
          <input type="email" id="modal-email" name="email" placeholder="you@example.com" required class="field-input" />
          <span class="field-hint">We'll send your PDF here as backup, and use it for your payment receipt.</span>
        </label>
        <button type="submit" id="modal-pay-btn" class="cta-pulse" style="width:100%;min-height:44px;background:var(--color-primary);color:#fff;border:none;border-radius:8px;font-size:1.05rem;font-weight:700;cursor:pointer;margin-top:0.5rem">
          Pay Securely
        </button>
