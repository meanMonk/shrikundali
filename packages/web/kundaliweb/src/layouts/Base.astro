---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const DEFAULT_DESCRIPTION =
  "Vedic Financial Kundali Report — Discover your financial destiny with personalized birth chart analysis.";
const pageDescription = description ?? DEFAULT_DESCRIPTION;
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID ?? "";
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "";
const GOOGLE_ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID ?? "";
const CLARITY_PROJECT_ID = import.meta.env.PUBLIC_CLARITY_PROJECT_ID ?? "";
const GTAG_ID = GA_MEASUREMENT_ID || GOOGLE_ADS_ID;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Rashi Kundali</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={`${title} | Rashi Kundali`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rashikundali.com" />
    <meta property="og:site_name" content="Rashi Kundali" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="rashikundali" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://connect.facebook.net" />
    <link rel="preconnect" href="https://www.clarity.ms" />

    <!-- Google tag (GA4 + Google Ads) -->
    {GTAG_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_ID}`}></script>
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());${GA_MEASUREMENT_ID ? `gtag('config','${GA_MEASUREMENT_ID}',{send_page_view:true});` : ""}${GOOGLE_ADS_ID ? `gtag('config','${GOOGLE_ADS_ID}',{allow_enhanced_conversions:true});` : ""}`}
        />
      </>
    )}

    <!-- Microsoft Clarity -->
    {CLARITY_PROJECT_ID && (
      <script
        is:inline
        set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${CLARITY_PROJECT_ID}");`}
      />
    )}

    <!-- Meta Pixel -->
    {META_PIXEL_ID && (
      <script
        is:inline
        set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${META_PIXEL_ID}');fbq('track','PageView');`}
      />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --color-primary: #B5451C;
        --color-primary-hover: #D45C2C;
        --color-secondary: #241E4E;
        --color-gold: #C9A227;
        --color-bg: #FBF6EF;
        --color-surface: #FFFFFF;
        --color-text: #2B2620;
        --color-text-muted: #7A7267;
        --color-success: #3F6B4C;
        --color-border: #E8DFD1;
        --font-heading: 'Fraunces', 'Noto Sans Devanagari', serif;
        --font-body: 'Inter', 'Noto Sans Devanagari', sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--font-body); color: var(--color-text); background: var(--color-bg); line-height: 1.6; }
      h1, h2, h3, .font-heading { font-family: var(--font-heading); }
      a { color: var(--color-primary); }
      .container { max-width: 900px; margin: 0 auto; padding: 1.5rem; }
      nav { background: var(--color-secondary); color: #fff; padding: 0.75rem 1.5rem; display: flex; align-items: center; }
      .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: #fff; }
      .brand-logo { width: 36px; height: 36px; border-radius: 8px; flex-shrink: 0; object-fit: contain; }
      .brand-name { font-family: var(--font-heading); font-weight: 600; font-size: 1.15rem; letter-spacing: 0.01em; }
      footer { text-align: center; padding: 1.5rem; margin-top: 2rem; border-top: 1px solid var(--color-border); }
      footer a { color: var(--color-text-muted); font-size: 0.85rem; margin: 0 0.5rem; text-decoration: none; }
      footer a:hover { color: var(--color-primary); }
      footer p { color: var(--color-text-muted); font-size: 0.75rem; margin-top: 0.5rem; }
      @media (max-width: 480px) {
        .container { padding: 1rem; }
        nav { padding: 0.6rem 1rem; }
        nav a { margin-right: 1rem; font-size: 0.85rem; }
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" class="brand">
        <img src="/logo.png" alt="RashiKundali" class="brand-logo" width="36" height="36" />
        <span class="brand-name">RashiKundali</span>
      </a>
    </nav>
    <div class="container">
      <slot />
    </div>
    <footer>
      <div>
        <a href="/about">About</a>
        <a href="/refund">Refund</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/sitemap">Sitemap</a>
      </div>
      <p>rashikundali.com</p>
    </footer>

    <!-- NoScript fallback for Meta Pixel -->
    {META_PIXEL_ID && (
      <noscript>
        <img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`} />
      </noscript>
    )}
  </body>
</html>
