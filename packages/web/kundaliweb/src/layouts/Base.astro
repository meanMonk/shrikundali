---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const DEFAULT_DESCRIPTION =
  "Vedic Financial Kundali Report — Discover your financial destiny with personalized birth chart analysis.";
const pageDescription = description ?? DEFAULT_DESCRIPTION;
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID ?? "";
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Shri Kundali</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={`${title} | Shri Kundali`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://shrikundali.in" />
    <meta property="og:site_name" content="Shri Kundali" />

    <!-- Meta Pixel -->
    {META_PIXEL_ID && (
      <script is:inline>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '{META_PIXEL_ID}');
        fbq('track', 'PageView');
      </script>
    )}

    <!-- Google Analytics -->
    {GA_MEASUREMENT_ID && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{GA_MEASUREMENT_ID}', { page_path: window.location.pathname });
      </script>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --color-primary: #B5451C;
        --color-primary-hover: #D45C2C;
        --color-secondary: #241E4E;
        --color-gold: #C9A227;
        --color-bg: #FBF6EF;
        --color-surface: #FFFFFF;
        --color-text: #2B2620;
        --color-text-muted: #7A7267;
        --color-success: #3F6B4C;
        --color-border: #E8DFD1;
        --font-heading: 'Fraunces', 'Noto Sans Devanagari', serif;
        --font-body: 'Inter', 'Noto Sans Devanagari', sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body { font-family: var(--font-body); color: var(--color-text); background: var(--color-bg); line-height: 1.6; }
      h1, h2, h3, .font-heading { font-family: var(--font-heading); }
      a { color: var(--color-primary); }
      .container { max-width: 900px; margin: 0 auto; padding: 1.5rem; }
      nav { background: var(--color-secondary); color: #fff; padding: 0.75rem 1.5rem; }
      nav a { color: #fff; text-decoration: none; margin-right: 1.5rem; font-size: 0.95rem; }
      nav a:hover { text-decoration: underline; }
      footer { text-align: center; padding: 1.5rem; margin-top: 2rem; border-top: 1px solid var(--color-border); }
      footer a { color: var(--color-text-muted); font-size: 0.85rem; margin: 0 0.5rem; text-decoration: none; }
      footer a:hover { color: var(--color-primary); }
      footer p { color: var(--color-text-muted); font-size: 0.75rem; margin-top: 0.5rem; }
      @media (max-width: 480px) {
        .container { padding: 1rem; }
        nav { padding: 0.6rem 1rem; }
        nav a { margin-right: 1rem; font-size: 0.85rem; }
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/docs" target="_blank">API Docs</a>
    </nav>
    <div class="container">
      <slot />
    </div>
    <footer>
      <div>
        <a href="/about">About</a>
        <a href="/refund">Refund</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/sitemap">Sitemap</a>
      </div>
      <p>&copy; 2026 Shri Kundali. All rights reserved.</p>
    </footer>

    <!-- NoScript fallback for Meta Pixel -->
    {META_PIXEL_ID && (
      <noscript>
        <img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`} />
      </noscript>
    )}
  </body>
</html>
