---
import Base from "../layouts/Base.astro";
const API = import.meta.env.VITE_API_URL ?? "http://localhost:3400";
---
<Base title="Financial Kundali Report">
  <style>
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    .cta-pulse { animation: pulse 2s ease-in-out infinite; }
    .score-box { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 8px; padding: 0.75rem; text-align: center; }
    .score-num { font-size: 1.5rem; font-weight: 700; color: var(--color-primary); }
    @media (max-width: 600px) { .grid-3 { grid-template-columns: 1fr !important; } .grid-2 { grid-template-columns: 1fr !important; } }
  </style>

  <div id="loading" style="text-align:center;padding:3rem;color:#888">Loading report details...</div>

  <div id="content" style="display:none">
    <div style="text-align:center;margin-bottom:1.5rem">
      <h1 id="report-title" style="color:var(--color-primary);margin-bottom:0.5rem"></h1>
      <p id="report-desc" style="color:#666;font-size:0.95rem;max-width:500px;margin:0 auto"></p>
    </div>

    <!-- Pricing -->
    <div style="background:#fff;border:2px solid var(--color-primary);border-radius:12px;padding:1.5rem;margin-bottom:1.5rem;text-align:center">
      <div style="display:flex;align-items:baseline;justify-content:center;gap:0.75rem;margin-bottom:0.5rem">
        <span id="report-price" style="font-size:2rem;font-weight:700;color:var(--color-primary)"></span>
        <span id="report-original" style="font-size:1.1rem;color:#888;text-decoration:line-through"></span>
        <span id="report-save" style="font-size:0.85rem;color:#0a0;font-weight:600;background:#efe;border-radius:4px;padding:0.2rem 0.5rem"></span>
      </div>
      <p style="font-size:0.85rem;color:#888">One-time payment &bull; Instant PDF &bull; Email delivery</p>
    </div>

    <!-- Features -->
    <div style="margin-bottom:1.5rem">
      <h2 style="color:var(--color-primary);font-size:1rem;margin-bottom:0.75rem;text-align:center">What You Get</h2>
      <div class="grid-3" id="features-list" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem"></div>
    </div>

    <!-- Teaser Scores -->
    <div style="background:#fff;border:1px solid var(--color-border);border-radius:12px;padding:1.5rem;margin-bottom:1.5rem">
      <h2 style="color:var(--color-primary);font-size:1rem;margin-bottom:0.75rem;text-align:center">Your Money-Axis Scores</h2>
      <div class="grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem">
        <div class="score-box"><div class="score-num" id="s-wealth">--</div><div style="font-size:0.7rem;color:#666">Wealth</div></div>
        <div class="score-box"><div class="score-num" id="s-career">--</div><div style="font-size:0.7rem;color:#666">Career</div></div>
        <div class="score-box"><div class="score-num" id="s-business">--</div><div style="font-size:0.7rem;color:#666">Business</div></div>
        <div class="score-box"><div class="score-num" id="s-property">--</div><div style="font-size:0.7rem;color:#666">Property</div></div>
        <div class="score-box"><div class="score-num" id="s-invest">--</div><div style="font-size:0.7rem;color:#666">Investment</div></div>
        <div class="score-box"><div class="score-num" id="s-stability">--</div><div style="font-size:0.7rem;color:#666">Stability</div></div>
      </div>
    </div>

    <!-- Payment Form -->
    <div style="background:#fff;border:1px solid var(--color-border);border-radius:12px;padding:1.5rem;margin-bottom:1.5rem">
      <h2 style="color:var(--color-primary);font-size:1rem;margin-bottom:1rem;text-align:center">Complete Your Purchase</h2>
      <form id="payment-form" style="max-width:400px;margin:0 auto">
        <div style="margin-bottom:1rem">
          <label style="display:flex;flex-direction:column;gap:0.25rem">
            <span style="font-weight:600;font-size:0.9rem">Name</span>
            <input type="text" id="pay-name" readonly
              style="padding:0.6rem;border:1px solid var(--color-border);border-radius:6px;background:var(--color-bg);font-size:16px;min-height:44px" />
          </label>
        </div>
        <div style="margin-bottom:1rem">
          <label style="display:flex;flex-direction:column;gap:0.25rem">
            <span style="font-weight:600;font-size:0.9rem">Email</span>
            <input type="email" id="pay-email" readonly
              style="padding:0.6rem;border:1px solid var(--color-border);border-radius:6px;background:var(--color-bg);font-size:16px;min-height:44px" />
          </label>
        </div>
        <div style="margin-bottom:1rem">
          <label style="display:flex;flex-direction:column;gap:0.25rem">
            <span style="font-weight:600;font-size:0.9rem">Payment Method</span>
            <select id="pay-provider" style="padding:0.6rem;border:1px solid var(--color-border);border-radius:6px;font-size:16px;min-height:44px">
              <option value="razorpay">Razorpay (UPI, Cards, Netbanking)</option>
              <option value="cashfree">Cashfree</option>
            </select>
          </label>
        </div>
        <button type="submit" class="cta-pulse" id="pay-btn"
          style="width:100%;min-height:44px;background:var(--color-primary);color:#fff;border:none;padding:1rem;border-radius:8px;font-size:1.1rem;font-weight:600;cursor:pointer;box-shadow:0 4px 16px rgba(181,69,28,0.3)">
          Pay &amp; Download Report &#8594;
        </button>
        <p style="font-size:0.8rem;color:#888;margin-top:0.75rem;text-align:center">&#x1F512; Secure payment &bull; Instant delivery</p>
      </form>
    </div>

    <div id="status" style="display:none;padding:0.75rem;border-radius:8px;margin-bottom:1rem;font-size:0.9rem;text-align:center"></div>

    <!-- Disclaimer -->
    <p style="font-size:0.75rem;color:#888;text-align:center;max-width:500px;margin:0 auto">
      This is Vedic Financial Kundali guidance, not SEBI-registered financial advice. Outcomes vary by individual.
    </p>
  </div>

  <script define:vars={{ API }}>
    const params = new URLSearchParams(window.location.search);
    const cacheId = params.get("cacheId");
    const email = params.get("email");
    const name = params.get("name");

    if (!cacheId || !email) {
      window.location.href = "/";
    }

    // Track page view
    if (typeof fbq === "function") fbq("track", "PageView");
    if (typeof gtag === "function") gtag("event", "page_view", { page_title: "Checkout" });

    let config = null;
    let scores = null;

    async function init() {
      const configRes = await fetch(`${API}/api/config/financial_kundali`);
      if (configRes.ok) {
        config = await configRes.json();
        document.getElementById("report-title").textContent = config.title;
        document.getElementById("report-desc").textContent = config.description;
        document.getElementById("report-price").textContent = `₹${config.discountPrice || config.price}`;
        if (config.discountPrice) {
          document.getElementById("report-original").textContent = `₹${config.price}`;
          document.getElementById("report-save").textContent = `Save ${Math.round((1 - config.discountPrice / config.price) * 100)}%`;
        }
        const featuresEl = document.getElementById("features-list");
        if (config.features) {
          featuresEl.innerHTML = config.features.map(f =>
            `<div style="display:flex;align-items:start;gap:0.5rem;padding:0.5rem;background:var(--color-bg);border-radius:6px;font-size:0.8rem">
              <span style="color:#0a0">&#10003;</span><span>${f}</span>
            </div>`
          ).join("");
        }
      }

      document.getElementById("pay-name").value = name || "";
      document.getElementById("pay-email").value = email || "";

      const cachedScores = sessionStorage.getItem("teaserScores");
      if (cachedScores) {
        scores = JSON.parse(cachedScores);
        updateScores(scores);
      } else {
        const teaserRes = await fetch(`${API}/teaser`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cacheId, datetime: "1990-01-01T12:00+05:30", coordinates: "19.0760,72.8777", ayanamsa: 1, email, label: name }),
        });
        if (teaserRes.ok) {
          const data = await teaserRes.json();
          scores = data.teaser?.moneyAxisScores;
          if (scores) {
            sessionStorage.setItem("teaserScores", JSON.stringify(scores));
            updateScores(scores);
          }
        }
      }

      document.getElementById("loading").style.display = "none";
      document.getElementById("content").style.display = "block";
    }

    function updateScores(s) {
      if (!s) return;
      document.getElementById("s-wealth").textContent = s.wealthPotential ?? "--";
      document.getElementById("s-career").textContent = s.careerGrowth ?? "--";
      document.getElementById("s-business").textContent = s.businessLuck ?? "--";
      document.getElementById("s-property").textContent = s.propertyAssets ?? "--";
      document.getElementById("s-invest").textContent = s.investmentSense ?? "--";
      document.getElementById("s-stability").textContent = s.financialStability ?? "--";
    }

    init();

    document.getElementById("payment-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("pay-btn");
      const statusEl = document.getElementById("status");
      btn.disabled = true;
      btn.textContent = "Processing...";

      if (typeof fbq === "function") fbq("track", "InitiateCheckout", { value: config?.discountPrice || config?.price || 199, currency: "INR" });
      if (typeof gtag === "function") gtag("event", "payment_initiated", { event_category: "funnel", value: config?.discountPrice || config?.price || 199 });

      const provider = document.getElementById("pay-provider").value;

      try {
        const res = await fetch(`${API}/payment/checkout`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ cacheId, provider, email, name }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: "Failed" }));
          statusEl.style.display = "block";
          statusEl.style.background = "#fee";
          statusEl.style.color = "#c00";
          statusEl.textContent = err.error || "Payment failed. Please try again.";
          btn.disabled = false;
          btn.textContent = "Pay & Download Report →";
          return;
        }

        const data = await res.json();

        if (typeof fbq === "function") fbq("track", "Purchase", { value: data.amount, currency: data.currency, content_ids: [data.orderId] });
        if (typeof gtag === "function") gtag("event", "payment_success", { event_category: "funnel", transaction_id: data.orderId, value: data.amount });

        if (provider === "razorpay" && data.key) {
          const options = {
            key: data.key,
            amount: data.amount * 100,
            currency: data.currency,
            name: "Shri Kundali",
            description: `Financial Kundali Report`,
            order_id: data.orderId,
            handler: function(response) {
              window.location.href = `/download?orderId=${data.orderId}`;
            },
            prefill: data.prefill,
            theme: { color: "var(--color-primary)" },
          };
          const rzp = new window.Razorpay(options);
          rzp.on("payment.failed", function() {
            statusEl.style.display = "block";
            statusEl.style.background = "#fee";
            statusEl.style.color = "#c00";
            statusEl.textContent = "Payment failed. Please try again.";
            btn.disabled = false;
            btn.textContent = "Pay & Download Report →";
          });
          rzp.open();
        } else if (provider === "cashfree" && data.checkoutUrl) {
          window.location.href = data.checkoutUrl;
        } else {
          statusEl.style.display = "block";
          statusEl.style.background = "#efe";
          statusEl.style.color = "#060";
          statusEl.textContent = `Order created: ${data.orderId}. Check your email for payment link.`;
        }
      } catch (err) {
        statusEl.style.display = "block";
        statusEl.style.background = "#fee";
        statusEl.style.color = "#c00";
        statusEl.textContent = `Error: ${err.message}`;
        btn.disabled = false;
        btn.textContent = "Pay & Download Report →";
      }
    });
  </script>

  <script src="https://checkout.razorpay.com/v1/checkout.js" async></script>
</Base>
