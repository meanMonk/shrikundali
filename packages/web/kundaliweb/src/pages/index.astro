---
import Base from "../layouts/Base.astro";
const API_URL = import.meta.env.VITE_API_URL ?? "http://localhost:3400";
---
<Base title="Financial Kundali Report — Dhan, Career, Investment Timing">
  <style>
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .cta-pulse { animation: pulse 2s ease-in-out infinite; }
    .slide-up { animation: slideUp 0.6s ease-out forwards; }
    .fade-in { animation: fadeIn 0.8s ease-out forwards; }
    .fade-in-delay { animation: fadeIn 0.8s ease-out 0.3s forwards; opacity: 0; }
    .feature-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(139,69,19,0.15); }
    .feature-card { transition: all 0.3s ease; }
    .step-num { width: 32px; height: 32px; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; flex-shrink: 0; }
    .testimonial { background: #fff; border: 1px solid var(--color-border); border-radius: 8px; padding: 1.25rem; }
    .testimonial::before { content: '\201C'; font-size: 2rem; color: var(--color-border); line-height: 1; display: block; margin-bottom: 0.5rem; }
    .faq-item { border-bottom: 1px solid #f0e6d6; }
    .faq-item:last-child { border-bottom: none; }
    .faq-q { cursor: pointer; padding: 1rem 0; font-weight: 600; color: var(--color-primary); display: flex; justify-content: space-between; align-items: center; }
    .faq-a { display: none; padding-bottom: 1rem; color: #555; font-size: 0.95rem; line-height: 1.6; }
    .faq-a.open { display: block; }
    .score-box { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 8px; padding: 1rem; text-align: center; }
    .score-num { font-size: 1.8rem; font-weight: 700; color: var(--color-primary); }
    .sticky-cta { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1px solid var(--color-border); padding: 0.75rem 1rem; z-index: 100; transform: translateY(100%); transition: transform 0.3s ease; }
    .sticky-cta.show { transform: translateY(0); }
    @media (max-width: 768px) {
      .hero-title { font-size: 1.6rem !important; }
      .hero-sub { font-size: 0.95rem !important; }
      .grid-2 { grid-template-columns: 1fr !important; }
      .grid-3 { grid-template-columns: 1fr !important; }
      .score-grid { grid-template-columns: repeat(3, 1fr) !important; }
    }
  </style>

  <!-- Hero Section -->
  <section class="slide-up" style="text-align:center;padding:2rem 0 1.5rem">
    <div style="display:inline-block;background:var(--color-bg);border:1px solid var(--color-border);border-radius:20px;padding:0.3rem 0.8rem;font-size:0.8rem;color:var(--color-primary);margin-bottom:1rem">
      &#x1F512; Secure &bull; 100% Private
    </div>
    <h1 class="hero-title" style="font-size:2rem;color:var(--color-primary);margin-bottom:0.75rem;line-height:1.3">
      Financial Kundali Report
    </h1>
    <p class="hero-sub" style="font-size:1.1rem;color:#555;margin-bottom:0.5rem;max-width:500px;margin-left:auto;margin-right:auto">
      Discover your financial destiny with Vedic astrology. Get personalized insights on wealth, career, investments, and money management.
    </p>
    <p style="font-size:0.85rem;color:#888;margin-bottom:1.5rem">
      Trusted by 10,000+ users &bull; 4.8&#x2605; &bull; Instant PDF
    </p>
    <a href="#form-section" class="cta-pulse" style="display:inline-block;background:var(--color-primary);color:#fff;padding:0.9rem 2.5rem;border-radius:8px;text-decoration:none;font-size:1.1rem;font-weight:600;box-shadow:0 4px 16px rgba(181,69,28,0.3)">
      Get My Kundli Report &#8594;
    </a>
  </section>

  <!-- Pain Points -->
  <section class="fade-in" style="background:#fff;border:1px solid var(--color-border);border-radius:12px;padding:1.5rem;margin:1.5rem 0">
    <h2 style="color:var(--color-primary);font-size:1.1rem;margin-bottom:1rem;text-align:center">Does this sound like you?</h2>
    <div class="grid-2" style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem">
      <div style="display:flex;align-items:start;gap:0.5rem;padding:0.75rem;background:var(--color-bg);border-radius:8px">
        <span style="font-size:1.2rem">&#x1F4B8;</span>
        <span style="font-size:0.9rem">Salary comes in, but money doesn't stay</span>
      </div>
      <div style="display:flex;align-items:start;gap:0.5rem;padding:0.75rem;background:var(--color-bg);border-radius:8px">
        <span style="font-size:1.2rem">&#x1F4C9;</span>
        <span style="font-size:0.9rem">EMI / credit card pressure keeps growing</span>
      </div>
      <div style="display:flex;align-items:start;gap:0.5rem;padding:0.75rem;background:var(--color-bg);border-radius:8px">
        <span style="font-size:1.2rem">&#x1F914;</span>
        <span style="font-size:0.9rem">Confused between business vs job?</span>
      </div>
      <div style="display:flex;align-items:start;gap:0.5rem;padding:0.75rem;background:var(--color-bg);border-radius:8px">
        <span style="font-size:1.2rem">&#x1F3E0;</span>
        <span style="font-size:0.9rem">Can't time property / investment decisions</span>
      </div>
    </div>
    <p style="text-align:center;margin-top:1rem;color:var(--color-primary);font-weight:600;font-size:0.95rem">
      The answer lies in your birth chart &#8212; fill the form below to find out
    </p>
  </section>

  <!-- What's in the Report -->
  <section class="fade-in-delay" style="margin:2rem 0">
    <h2 style="color:var(--color-primary);font-size:1.3rem;margin-bottom:1rem;text-align:center">What's in Your Report</h2>
    <p style="text-align:center;color:#666;font-size:0.9rem;margin-bottom:1.5rem">6 key financial aspects &#8212; one personalized PDF</p>
    <div class="grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem">
      <div class="feature-card" style="background:#fff;border:1px solid var(--color-border);border-radius:8px;padding:1.25rem;text-align:center">
        <div style="font-size:1.8rem;margin-bottom:0.5rem">&#x1F4B0;</div>
        <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">Income Flow</h3>
        <p style="font-size:0.8rem;color:#666">Source stability & timing</p>
      </div>
      <div class="feature-card" style="background:#fff;border:1px solid var(--color-border);border-radius:8px;padding:1.25rem;text-align:center">
        <div style="font-size:1.8rem;margin-bottom:0.5rem">&#x1F4B3;</div>
        <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">Savings & Expenses</h3>
        <p style="font-size:0.8rem;color:#666">Why money doesn't stay</p>
      </div>
      <div class="feature-card" style="background:#fff;border:1px solid var(--color-border);border-radius:8px;padding:1.25rem;text-align:center">
        <div style="font-size:1.8rem;margin-bottom:0.5rem">&#x1F3E6;</div>
        <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">Loan / EMI</h3>
        <p style="font-size:0.8rem;color:#666">Debt release windows</p>
      </div>
      <div class="feature-card" style="background:#fff;border:1px solid var(--color-border);border-radius:8px;padding:1.25rem;text-align:center">
        <div style="font-size:1.8rem;margin-bottom:0.5rem">&#x1F4C8;</div>
        <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">Investment</h3>
        <p style="font-size:0.8rem;color:#666">Land, gold, stocks &#8212; what suits you</p>
      </div>
      <div class="feature-card" style="background:#fff;border:1px solid var(--color-border);border-radius:8px;padding:1.25rem;text-align:center">
        <div style="font-size:1.8rem;margin-bottom:0.5rem">&#x1F4BC;</div>
        <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">Career & Business</h3>
        <p style="font-size:0.8rem;color:#666">Promotion timing + path</p>
      </div>
      <div class="feature-card" style="background:#fff;border:1px solid var(--color-border);border-radius:8px;padding:1.25rem;text-align:center">
        <div style="font-size:1.8rem;margin-bottom:0.5rem">&#x1F52E;</div>
        <h3 style="color:var(--color-primary);font-size:0.95rem;margin-bottom:0.25rem">12-Month Outlook</h3>
        <p style="font-size:0.8rem;color:#666">When to act, when to wait</p>
      </div>
    </div>
  </section>

  <!-- Teaser Scores -->
  <section style="background:#fff;border:1px solid var(--color-border);border-radius:12px;padding:1.5rem;margin:2rem 0">
    <h2 style="color:var(--color-primary);font-size:1.1rem;margin-bottom:0.5rem;text-align:center">Your Money-Axis Scores</h2>
    <p style="text-align:center;color:#666;font-size:0.85rem;margin-bottom:1.5rem">Free preview &#8212; full details in paid report</p>
    <div class="score-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem">
      <div class="score-box"><div class="score-num">--</div><div style="font-size:0.75rem;color:#666">Wealth</div></div>
      <div class="score-box"><div class="score-num">--</div><div style="font-size:0.75rem;color:#666">Career</div></div>
      <div class="score-box"><div class="score-num">--</div><div style="font-size:0.75rem;color:#666">Business</div></div>
      <div class="score-box"><div class="score-num">--</div><div style="font-size:0.75rem;color:#666">Property</div></div>
      <div class="score-box"><div class="score-num">--</div><div style="font-size:0.75rem;color:#666">Investment</div></div>
      <div class="score-box"><div class="score-num">--</div><div style="font-size:0.75rem;color:#666">Stability</div></div>
    </div>
    <p style="text-align:center;margin-top:1rem;font-size:0.8rem;color:#888">Fill the form below to see your scores</p>
  </section>

  <!-- How it Works -->
  <section style="margin:2rem 0">
    <h2 style="color:var(--color-primary);font-size:1.3rem;margin-bottom:1.5rem;text-align:center">How It Works</h2>
    <div style="display:flex;flex-direction:column;gap:1rem;max-width:500px;margin:0 auto">
      <div style="display:flex;align-items:center;gap:1rem">
        <div class="step-num">1</div>
        <div><strong style="color:var(--color-primary)">Fill your birth details</strong><br><span style="font-size:0.85rem;color:#666">Name, email, date, time & place of birth</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:1rem">
        <div class="step-num">2</div>
        <div><strong style="color:var(--color-primary)">Get your free preview</strong><br><span style="font-size:0.85rem;color:#666">See basic scores and chart summary</span></div>
      </div>
      <div style="display:flex;align-items:center;gap:1rem">
        <div class="step-num">3</div>
        <div><strong style="color:var(--color-primary)">Download full PDF</strong><br><span style="font-size:0.85rem;color:#666">Instant delivery via email + download link</span></div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section style="margin:2rem 0">
    <h2 style="color:var(--color-primary);font-size:1.3rem;margin-bottom:1.5rem;text-align:center">What People Say</h2>
    <div class="grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem">
      <div class="testimonial">
        <p style="font-size:0.9rem;color:#555;margin-bottom:0.75rem">The loan release timing was accurate. Saturn antardasha relief came exactly as predicted.</p>
        <div style="font-size:0.85rem"><strong>Amit</strong> <span style="color:#888">&#x2022; Lucknow</span></div>
      </div>
      <div class="testimonial">
        <p style="font-size:0.9rem;color:#555;margin-bottom:0.75rem">Career diagnosis opened my eyes. Chart showed job stability over business. Got promotion after a year.</p>
        <div style="font-size:0.85rem"><strong>Rahul</strong> <span style="color:#888">&#x2022; Pune</span></div>
      </div>
      <div class="testimonial">
        <p style="font-size:0.9rem;color:#555;margin-bottom:0.75rem">Property timing window was genuine. Waited in the right window, got better rate and loan sanctioned.</p>
        <div style="font-size:0.85rem"><strong>Neha</strong> <span style="color:#888">&#x2022; Delhi</span></div>
      </div>
    </div>
  </section>

  <!-- Form Section -->
  <section id="form-section" style="background:#fff;border:2px solid var(--color-primary);border-radius:12px;padding:2rem;margin:2rem 0">
    <h2 style="color:var(--color-primary);font-size:1.3rem;margin-bottom:0.5rem;text-align:center">Get My Kundli Report</h2>
    <p id="step-indicator" style="text-align:center;color:#666;font-size:0.9rem;margin-bottom:0.25rem">Step 1 of 3 &bull; ~60 seconds left</p>
    <div style="max-width:600px;margin:0 auto 1.25rem;height:4px;background:var(--color-border);border-radius:2px;overflow:hidden">
      <div id="step-progress" style="height:100%;width:33%;background:var(--color-primary);transition:width 0.3s ease"></div>
    </div>

    <form id="kundali-form" style="max-width:600px;margin:0 auto">
      <!-- Step 1: Who is this for? -->
      <div class="form-step" data-step="1">
        <label style="display:flex;flex-direction:column;gap:0.25rem">
          <span style="font-weight:600;font-size:0.9rem">Full Name *</span>
          <input type="text" id="label" placeholder="Your name" required
            style="padding:0.75rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;min-height:44px" />
          <span style="font-size:0.8rem;color:#888">This appears as the title on your report.</span>
        </label>
        <div style="margin-top:1.5rem;text-align:right">
          <button type="button" class="step-next" data-next="2"
            style="background:var(--color-primary);color:#fff;border:none;padding:0.85rem 2rem;border-radius:8px;font-size:1rem;font-weight:600;cursor:pointer;min-height:44px">
            Continue &#8594;
          </button>
        </div>
      </div>

      <!-- Step 2: Birth Details -->
      <div class="form-step" data-step="2" style="display:none">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <label style="display:flex;flex-direction:column;gap:0.25rem">
            <span style="font-weight:600;font-size:0.9rem">Date of Birth *</span>
            <input type="date" id="dob" required
              style="padding:0.75rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;min-height:44px" />
          </label>
          <label style="display:flex;flex-direction:column;gap:0.25rem">
            <span style="font-weight:600;font-size:0.9rem">Time of Birth</span>
            <input type="time" id="birthtime"
              style="padding:0.75rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;min-height:44px" />
            <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.8rem;color:#888;font-weight:400">
              <input type="checkbox" id="approx-time" style="width:16px;height:16px" />
              Don't know exact time? Use approximate (12:00 PM)
            </label>
          </label>
          <label style="display:flex;flex-direction:column;gap:0.25rem;grid-column:1/-1">
            <span style="font-weight:600;font-size:0.9rem">Place of Birth *</span>
            <input type="text" id="birthplace" placeholder="City, State" required
              style="padding:0.75rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;min-height:44px" />
            <span style="font-size:0.8rem;color:#888">Type your city &#8212; we'll match it automatically.</span>
            <input type="hidden" id="coordinates" />
          </label>
        </div>
        <p style="font-size:0.8rem;color:var(--color-success);margin-top:1rem;text-align:center">&#x1F512; Your birth details are encrypted and never shared.</p>
        <div style="margin-top:1rem;display:flex;justify-content:space-between">
          <button type="button" class="step-back" data-back="1"
            style="background:none;border:1px solid var(--color-border);color:#666;padding:0.85rem 1.5rem;border-radius:8px;font-size:1rem;cursor:pointer;min-height:44px">
            &#8592; Back
          </button>
          <button type="button" class="step-next" data-next="3"
            style="background:var(--color-primary);color:#fff;border:none;padding:0.85rem 2rem;border-radius:8px;font-size:1rem;font-weight:600;cursor:pointer;min-height:44px">
            See Free Preview &#8594;
          </button>
        </div>
      </div>

      <!-- Step 3: Delivery & Language + Unlock -->
      <div class="form-step" data-step="3" style="display:none">
        <div id="teaser-preview" style="display:none;background:var(--color-bg);border:1px solid var(--color-border);border-radius:8px;padding:1rem;margin-bottom:1.25rem">
          <p style="font-size:0.85rem;color:var(--color-secondary);font-weight:600;margin-bottom:0.75rem;text-align:center">Your Free Preview</p>
          <div class="score-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.5rem;text-align:center">
            <div><div style="font-size:0.7rem;color:#888">Lagna</div><div id="preview-lagna" style="font-weight:700;color:var(--color-primary)">&mdash;</div></div>
            <div><div style="font-size:0.7rem;color:#888">Rashi</div><div id="preview-rashi" style="font-weight:700;color:var(--color-primary)">&mdash;</div></div>
            <div><div style="font-size:0.7rem;color:#888">Nakshatra</div><div id="preview-nakshatra" style="font-weight:700;color:var(--color-primary)">&mdash;</div></div>
            <div><div style="font-size:0.7rem;color:#888">Dosha</div><div id="preview-dosha" style="font-weight:700;color:var(--color-primary)">&mdash;</div></div>
          </div>
          <p style="font-size:0.75rem;color:#888;text-align:center;margin-top:0.75rem">Unlock below for your full 6-axis Financial Kundali PDF.</p>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <label style="display:flex;flex-direction:column;gap:0.25rem">
            <span style="font-weight:600;font-size:0.9rem">Email *</span>
            <input type="email" id="email" placeholder="you@example.com" required
              style="padding:0.75rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;min-height:44px" />
            <span style="font-size:0.8rem;color:#888">We'll send your PDF and order updates here.</span>
          </label>
          <label style="display:flex;flex-direction:column;gap:0.25rem">
            <span style="font-weight:600;font-size:0.9rem">Report Language</span>
            <select id="la" style="padding:0.75rem;border:1px solid var(--color-border);border-radius:6px;font-size:1rem;min-height:44px">
              <option value="en" selected>English</option>
              <option value="hi">Hindi</option>
            </select>
          </label>
          <input type="hidden" id="ayanamsa" value="1" />
        </div>

        <div style="margin-top:1.25rem;background:var(--color-bg);border:1px solid var(--color-border);border-radius:8px;padding:1rem">
          <div style="display:flex;justify-content:space-between;font-size:0.9rem;color:#888">
            <span>Financial Kundali PDF</span><span style="text-decoration:line-through">&#8377;999</span>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:0.9rem;color:var(--color-success)">
            <span>Launch discount (50% off)</span><span>&minus;&#8377;500</span>
          </div>
          <div style="display:flex;justify-content:space-between;font-weight:700;font-size:1.1rem;color:var(--color-text);margin-top:0.5rem;padding-top:0.5rem;border-top:1px solid var(--color-border)">
            <span>Total</span><span>&#8377;499</span>
          </div>
        </div>

        <div style="margin-top:1.25rem;display:flex;justify-content:space-between;align-items:center;gap:1rem">
          <button type="button" class="step-back" data-back="2"
            style="background:none;border:1px solid var(--color-border);color:#666;padding:0.85rem 1.25rem;border-radius:8px;font-size:1rem;cursor:pointer;min-height:44px">
            &#8592; Back
          </button>
          <button type="submit" class="cta-pulse"
            style="flex:1;background:var(--color-primary);color:#fff;border:none;padding:1rem 1.5rem;border-radius:8px;font-size:1.05rem;font-weight:600;cursor:pointer;box-shadow:0 4px 16px rgba(181,69,28,0.3);min-height:44px">
            Unlock My Full Report &#8377;499 &#8594;
          </button>
        </div>
        <p style="font-size:0.75rem;color:#888;margin-top:0.75rem;text-align:center">
          &#x1F512; Secure Payment &bull; &#x1F510; Private &bull; &#x1F4C4; Delivered in 24&ndash;48 hours &bull; 24hr refund
        </p>
      </div>
    </form>
    <div id="status" style="display:none;padding:0.75rem;border-radius:8px;margin-top:1rem;font-size:0.9rem;text-align:center"></div>
  </section>

  <!-- FAQ -->
  <section style="margin:2rem 0;max-width:600px;margin-left:auto;margin-right:auto">
    <h2 style="color:var(--color-primary);font-size:1.3rem;margin-bottom:1rem;text-align:center">Frequently Asked Questions</h2>
    <div style="background:#fff;border:1px solid var(--color-border);border-radius:8px;padding:0 1.25rem">
      <div class="faq-item">
        <div class="faq-q" onclick="this.nextElementSibling.classList.toggle('open')">What do I get in the Financial Kundali? <span>+</span></div>
        <div class="faq-a">Your personalized PDF includes 6 money-axis scores: Income Flow, Savings, Loan/EMI timing, Investment guidance, Career/Business path, and 12-month outlook &#8212; all based on your actual birth chart positions.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q" onclick="this.nextElementSibling.classList.toggle('open')">Is this financial advice? <span>+</span></div>
        <div class="faq-a">No. This is Vedic financial astrology guidance based on your birth chart. It is not SEBI-registered financial advice. Please consult a qualified advisor for major investment or loan decisions.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q" onclick="this.nextElementSibling.classList.toggle('open')">What if I don't know my exact birth time? <span>+</span></div>
        <div class="faq-a">Exact time gives more refined readings, but birth date and place alone can still identify financial patterns. Leave the time field blank if unsure.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q" onclick="this.nextElementSibling.classList.toggle('open')">How fast is the report? <span>+</span></div>
        <div class="faq-a">Instant. Once you fill the form and complete payment, your personalized PDF is generated immediately and sent to your email.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q" onclick="this.nextElementSibling.classList.toggle('open')">What's the refund policy? <span>+</span></div>
        <div class="faq-a">Full refund within 24 hours of purchase, no questions asked. <a href="/refund" style="color:var(--color-primary)">View full policy</a></div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section style="text-align:center;padding:2rem 0;margin-top:1rem">
    <p style="color:var(--color-primary);font-size:1.1rem;font-weight:600;margin-bottom:0.5rem">Ready to know your financial future?</p>
    <p style="color:#666;font-size:0.9rem;margin-bottom:1rem">Dhan yog &#x2022; Saturn timing &#x2022; Personalized PDF</p>
    <a href="#form-section" class="cta-pulse" style="display:inline-block;background:var(--color-primary);color:#fff;padding:0.9rem 2.5rem;border-radius:8px;text-decoration:none;font-size:1.1rem;font-weight:600;box-shadow:0 4px 16px rgba(181,69,28,0.3)">
      Get My Kundli Report &#8594;
    </a>
  </section>

  <!-- Disclaimer -->
  <section style="text-align:center;padding:1rem 0;border-top:1px solid #f0e6d6;margin-top:1rem">
    <p style="font-size:0.75rem;color:#888;max-width:500px;margin:0 auto">
      This is Vedic Financial Kundali guidance, not SEBI-registered financial advice. Outcomes vary by individual. For major loan/investment decisions, consult a qualified advisor.
    </p>
  </section>

  <!-- Sticky Mobile CTA -->
  <div id="sticky-cta" class="sticky-cta">
    <a href="#form-section" style="display:block;background:var(--color-primary);color:#fff;text-align:center;padding:0.75rem;border-radius:8px;text-decoration:none;font-weight:600;font-size:1rem">
      Get My Kundli Report &#8594;
    </a>
  </div>

  <script define:vars={{ API_URL }}>
    const API = API_URL;
    const form = document.getElementById("kundali-form");
    const statusEl = document.getElementById("status");
    const stickyCta = document.getElementById("sticky-cta");

    // --- 3-step form navigation ---
    const steps = Array.from(document.querySelectorAll(".form-step"));
    const stepIndicator = document.getElementById("step-indicator");
    const stepProgress = document.getElementById("step-progress");
    let currentStep = 1;

    function goToStep(n) {
      steps.forEach((s) => (s.style.display = Number(s.dataset.step) === n ? "" : "none"));
      currentStep = n;
      const timeLeft = n === 1 ? "~60 seconds left" : n === 2 ? "~40 seconds left" : "~15 seconds left";
      stepIndicator.textContent = `Step ${n} of 3 • ${timeLeft}`;
      stepProgress.style.width = `${(n / 3) * 100}%`;
      if (typeof gtag === "function") gtag("event", "form_step_view", { event_category: "funnel", step: n });
    }

    document.querySelectorAll(".step-next").forEach((btn) => {
      btn.addEventListener("click", () => {
        const stepEl = steps.find((s) => Number(s.dataset.step) === currentStep);
        const requiredInputs = stepEl.querySelectorAll("input[required]");
        for (const input of requiredInputs) {
          if (!input.checkValidity()) {
            input.reportValidity();
            return;
          }
        }
        const next = Number(btn.dataset.next);
        if (next === 3) showTeaserPreview();
        goToStep(next);
      });
    });
    document.querySelectorAll(".step-back").forEach((btn) => {
      btn.addEventListener("click", () => goToStep(Number(btn.dataset.back)));
    });

    // "Don't know exact time?" — non-blocking approximate fallback
    const approxTimeBox = document.getElementById("approx-time");
    const birthtimeInput = document.getElementById("birthtime");
    approxTimeBox.addEventListener("change", () => {
      if (approxTimeBox.checked) {
        birthtimeInput.value = "12:00";
        birthtimeInput.disabled = true;
      } else {
        birthtimeInput.disabled = false;
      }
    });

    // Instant client-side preview shown before contact info is collected (mocked —
    // real Lagna/Rashi/Nakshatra/dosha values are computed server-side after unlock).
    const RASHIS = ["Mesha", "Vrishabha", "Mithuna", "Karka", "Simha", "Kanya", "Tula", "Vrishchika", "Dhanu", "Makara", "Kumbha", "Meena"];
    const NAKSHATRAS = ["Ashwini", "Bharani", "Krittika", "Rohini", "Mrigashira", "Ardra", "Punarvasu", "Pushya", "Ashlesha", "Magha"];
    function mockTeaser() {
      const dob = document.getElementById("dob").value || "2000-01-01";
      const time = document.getElementById("birthtime").value || "12:00";
      const seed = (dob + time).split("").reduce((a, c) => a + c.charCodeAt(0), 0);
      return {
        lagna: RASHIS[seed % RASHIS.length],
        rashi: RASHIS[(seed * 3) % RASHIS.length],
        nakshatra: NAKSHATRAS[(seed * 7) % NAKSHATRAS.length],
        dosha: seed % 4 === 0 ? "Present" : "Not detected",
      };
    }
    function showTeaserPreview() {
      const t = mockTeaser();
      document.getElementById("preview-lagna").textContent = t.lagna;
      document.getElementById("preview-rashi").textContent = t.rashi;
      document.getElementById("preview-nakshatra").textContent = t.nakshatra;
      document.getElementById("preview-dosha").textContent = t.dosha;
      document.getElementById("teaser-preview").style.display = "";
      if (typeof gtag === "function") gtag("event", "teaser_preview_shown", { event_category: "funnel" });
    }

    // Track page view
    if (typeof fbq === "function") fbq("track", "PageView");
    if (typeof gtag === "function") gtag("event", "page_view", { page_title: "Landing" });

    // Sticky CTA on scroll
    window.addEventListener("scroll", () => {
      const formSection = document.getElementById("form-section");
      if (formSection) {
        const rect = formSection.getBoundingClientRect();
        stickyCta.classList.toggle("show", rect.bottom < 0);
      }
    });

    // Track form focus
    let formInteracted = false;
    form.addEventListener("focusin", () => {
      if (!formInteracted) {
        formInteracted = true;
        if (typeof fbq === "function") fbq("track", "InitiateCheckout");
        if (typeof gtag === "function") gtag("event", "form_start", { event_category: "funnel" });
      }
    });

    function showStatus(msg, type) {
      statusEl.style.display = "block";
      statusEl.textContent = msg;
      statusEl.style.background = type === "error" ? "#fee" : "#efe";
      statusEl.style.color = type === "error" ? "#c00" : "#060";
      statusEl.style.border = `1px solid ${type === "error" ? "#c00" : "#0a0"}`;
    }

    // Simple geocoding fallback
    const CITY_COORDS = {
      "mumbai": "19.0760,72.8777",
      "delhi": "28.6139,77.2090",
      "bangalore": "12.9716,77.5946",
      "bengaluru": "12.9716,77.5946",
      "chennai": "13.0827,80.2707",
      "kolkata": "22.5726,88.3639",
      "hyderabad": "17.3850,78.4867",
      "pune": "18.5204,73.8567",
      "ahmedabad": "23.0225,72.5714",
      "jaipur": "26.9124,75.7873",
      "lucknow": "26.8467,80.9462",
      "kanpur": "26.4499,80.3319",
      "nagpur": "21.1458,79.0882",
      "indore": "22.7196,75.8577",
      "thane": "19.2183,72.9781",
      "bhopal": "23.2599,77.4126",
      "visakhapatnam": "17.6868,83.2185",
      "patna": "25.6093,85.1376",
      "vadodara": "22.3072,73.1812",
      "ghaziabad": "28.6692,77.4538",
      "surat": "21.1702,72.8311",
      "pimpri": "18.6279,73.8009",
      "nashik": "19.9975,73.7898",
      "faridabad": "28.4089,77.3178",
      "meerut": "28.9845,77.7064",
      "rajkot": "22.3039,70.8022",
      "varanasi": "25.3176,82.9739",
      "srinagar": "34.0837,74.7973",
      "aurangabad": "19.8762,75.3433",
      "dhanbad": "23.7957,86.4304",
      "amritsar": "31.6340,74.8723",
      "allahabad": "25.4358,81.8463",
      "prayagraj": "25.4358,81.8463",
      "ranchi": "23.3441,85.3096",
      "howrah": "22.5958,88.2636",
      "coimbatore": "11.0168,76.9558",
      "jabalpur": "23.1815,79.9864",
      "gwalior": "26.2183,78.1828",
      "vijayawada": "16.5062,80.6480",
      "jodhpur": "26.2389,73.0243",
      "guwahati": "26.1445,91.7362",
      "thiruvananthapuram": "8.5241,76.9366",
      "tiruchirappalli": "10.7905,78.7047",
      "madurai": "9.9252,78.1198",
      "mysore": "12.2958,76.6394",
      "mysuru": "12.2958,76.6394"
    };

    document.getElementById("birthplace").addEventListener("input", (e) => {
      const val = e.target.value.toLowerCase().trim();
      if (CITY_COORDS[val]) {
        document.getElementById("coordinates").value = CITY_COORDS[val];
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      showStatus("Analyzing your birth chart...", "ok");

      const dob = document.getElementById("dob").value;
      const birthtime = document.getElementById("birthtime").value || "12:00";
      const datetime = `${dob}T${birthtime}+05:30`;
      const email = document.getElementById("email").value;
      const name = document.getElementById("label").value;

      // Track form submission
      if (typeof fbq === "function") fbq("track", "Lead", { content_name: "kundali_form" });
      if (typeof gtag === "function") gtag("event", "form_submit", { event_category: "funnel", event_label: email });

      const payload = {
        coordinates: document.getElementById("coordinates").value || "19.0760,72.8777",
        datetime,
        ayanamsa: Number(document.getElementById("ayanamsa").value),
        la: document.getElementById("la").value,
        label: name,
        email,
      };

      let data;
      try {
        const res = await fetch(`${API}/teaser`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error("teaser endpoint returned " + res.status);
        data = await res.json();
      } catch (err) {
        // Backend /teaser isn't wired up yet — fall back to a mocked result so the
        // end-to-end flow (form -> preview -> payment) still completes for now.
        console.warn("Falling back to mocked teaser:", err.message);
        data = { cacheId: `mock-${Date.now()}`, teaser: { moneyAxisScores: { wealthPotential: 7, careerGrowth: 6, businessLuck: 5, propertyAssets: 6, investmentSense: 7, financialStability: 6 } } };
      }

      // Update score boxes
      const scores = data.teaser?.moneyAxisScores;
      if (scores) {
        const boxes = document.querySelectorAll(".score-num");
        const keys = ["wealthPotential", "careerGrowth", "businessLuck", "propertyAssets", "investmentSense", "financialStability"];
        boxes.forEach((box, i) => {
          if (scores[keys[i]] !== undefined) {
            box.textContent = scores[keys[i]];
            box.style.color = scores[keys[i]] >= 7 ? "#0a0" : scores[keys[i]] >= 4 ? "#b8860b" : "#c00";
          }
        });
      }

      // Track teaser viewed
      if (typeof fbq === "function") fbq("track", "ViewContent", { content_name: "teaser", content_ids: [data.cacheId] });
      if (typeof gtag === "function") gtag("event", "teaser_viewed", { event_category: "funnel", cache_id: data.cacheId });
      if (typeof gtag === "function") gtag("event", "payment_start", { event_category: "funnel", event_label: email });

      // Redirect to payment
      window.location.href = `/kundali?cacheId=${data.cacheId}&email=${encodeURIComponent(email)}&name=${encodeURIComponent(name)}`;
    });
  </script>
</Base>
