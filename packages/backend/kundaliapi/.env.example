# Kundali API environment variables
# Copy to .env and fill in values

# Server
PORT=3400
APP_URL=https://kundaliapi.shrikundali.com

# MongoDB (on VPS, connects to existing vaayu-mongo)
MONGODB_URI=mongodb://mongo:27017/app_kundaliapi

# PostgreSQL (optional, for future use)
PG_URI=postgres://postgres:postgres@postgres:5432/app_kundaliapi

# Prokerala API (REQUIRED for kundali generation)
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# Payment - Razorpay (REQUIRED for checkout)
# Test keys: use rzp_test_* for development, rzp_live_* for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay dashboard (recommended in production).
# If empty, webhook signatures are not enforced (generation is still gated on a known order id).
RAZORPAY_WEBHOOK_SECRET=

# Payment - Cashfree (optional, alternative to Razorpay)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Report pricing (must match frontend display price)
# Default: 99 (discountPrice from config). Override via env for A/B testing.
REPORT_PRICE_INR=99

# Email - Zoho SMTP (for sending PDF reports)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_FROM=support@shrikundali.com

# Telegram Bot (for order notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# MinIO Storage (set MINIO_ENDPOINT=true to use MinIO instead of local filesystem)
MINIO_ENDPOINT=true
MINIO_HOST=host.docker.internal
MINIO_PORT=9000
MINIO_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shrikundali
