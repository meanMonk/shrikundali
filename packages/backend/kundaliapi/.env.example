# Kundali API environment variables
# Copy to .env and fill in values

# Server
PORT=3400
APP_URL=https://kundaliapi.shrikundali.vaayulabs.com
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=https://shrikundali.vaayulabs.com,https://www.shrikundali.vaayulabs.com

# MongoDB (single source of truth)
# Local brew mongod: mongodb://localhost:27017/app_kundaliapi
# VPS docker:        mongodb://mongo:27017/app_kundaliapi
DB_TYPE=mongo
DB_NAME=app_kundaliapi
MONGODB_URI=mongodb://mongo:27017/app_kundaliapi

# Prokerala API (REQUIRED for kundali generation)
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# Payment - Razorpay (REQUIRED for checkout)
# Test keys: use rzp_test_* for development, rzp_live_* for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay dashboard (recommended in production).
# If empty, webhook signatures are not enforced (generation is still gated on a known order id).
RAZORPAY_WEBHOOK_SECRET=

# Payment - Cashfree (optional, alternative to Razorpay)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Report pricing (INR). Defaults: financial_kundali=199, match_kundali=299.
# Optional per-type overrides for A/B tests:
# REPORT_PRICE_FINANCIAL_KUNDALI=199
# REPORT_PRICE_MATCH_KUNDALI=299

# ── Ad conversions (server-side) ─────────────────────────────
# Meta Conversions API. Deduplicated with the browser pixel via event_id.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: route events to Events Manager > Test Events.
META_TEST_EVENT_CODE=

# GA4 Measurement Protocol. Deduplicated with the browser tag via transaction_id.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Email - Zoho SMTP (for sending PDF reports)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_FROM=support@shrikundali.com

# Telegram Bot (sale/download/startup notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# alias accepted by the code (comma-separated for multiple admins):
# TELEGRAM_CHAT_ID=

# MinIO Storage (set MINIO_ENDPOINT=true to use MinIO instead of local filesystem)
MINIO_ENDPOINT=true
MINIO_HOST=host.docker.internal
MINIO_PORT=9000
MINIO_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shrikundali
