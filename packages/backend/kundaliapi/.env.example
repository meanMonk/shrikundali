# Copy to .env and edit. Kept in git as a reference.
PORT=3400
SERVICE_NAME=kundaliapi
DB_TYPE=mongo
DB_NAME=app_kundaliapi

# ------------------------------------------------------------------
# Mongo — ONE canonical URI, two targets:
#   local dev (brew mongod) : 127.0.0.1, no auth  (creds are ignored)
#   docker / VPS            : `mongo` on vaayu_db  (container name)
# After `sudo bash scripts/hosts-local.sh`, `mongo` -> 127.0.0.1 so the
# SAME `mongo:27017` URI works both in docker and via brew.
# ------------------------------------------------------------------
MONGODB_URI=mongodb://kundaliapi:change_me@mongo:27017/app_kundaliapi?authSource=app_kundaliapi

# Postgres (only when DB_TYPE=postgres)
#   local dev (brew) : 127.0.0.1  |  docker/VPS: `postgres` on vaayu_db
PG_URI=postgres://kundaliapi:change_me@postgres:5432/app_kundaliapi

# Docs
OPENAPI_TITLE=kundaliapi API

# ProKerala Astrology API (https://api.prokerala.com)
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree (https://www.cashfree.com) — optional fallback
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# App URL (for payment return URLs)
APP_URL=http://localhost:3400

# Zoho SMTP (https://www.zoho.com/mail/)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_FROM=

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=