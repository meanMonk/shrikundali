{
  "openapi": "3.0.0",
  "info": {
    "title": "kundaliapi API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3400"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/kundali/generate": {
      "post": {
        "tags": [
          "Kundali"
        ],
        "summary": "Generate Kundali (JSON)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "coordinates": {
                    "type": "string",
                    "description": "lat,lon — e.g. 23.1765,75.7885"
                  },
                  "datetime": {
                    "type": "string",
                    "description": "ISO 8601 datetime with timezone offset — e.g. 2026-09-04T09:54:15+05:30"
                  },
                  "ayanamsa": {
                    "type": "number",
                    "default": 1,
                    "description": "1=Lahiri, 3=Raman, 5=KP"
                  },
                  "la": {
                    "type": "string",
                    "description": "Language: en, ta, ml, hi"
                  },
                  "label": {
                    "type": "string",
                    "description": "Name/title for the report"
                  }
                },
                "required": [
                  "coordinates",
                  "datetime"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kundali data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "nullable": true
                      }
                    }
                  },
                  "required": [
                    "status",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
