FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/web/kundaliweb/package.json ./packages/web/kundaliweb/
RUN pnpm install

FROM base AS build
ARG VITE_API_URL=
ARG PUBLIC_API_URL=
ARG PUBLIC_META_PIXEL_ID=
ARG PUBLIC_GA_MEASUREMENT_ID=
ARG PUBLIC_GOOGLE_ADS_ID=
ARG PUBLIC_GOOGLE_ADS_LEAD_LABEL=
ARG PUBLIC_GOOGLE_ADS_CHECKOUT_LABEL=
ARG PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
ARG PUBLIC_CLARITY_PROJECT_ID=
ARG PUBLIC_GOOGLE_MAPS_API_KEY=
ENV VITE_API_URL=$VITE_API_URL \
    PUBLIC_API_URL=$PUBLIC_API_URL \
    PUBLIC_META_PIXEL_ID=$PUBLIC_META_PIXEL_ID \
    PUBLIC_GA_MEASUREMENT_ID=$PUBLIC_GA_MEASUREMENT_ID \
    PUBLIC_GOOGLE_ADS_ID=$PUBLIC_GOOGLE_ADS_ID \
    PUBLIC_GOOGLE_ADS_LEAD_LABEL=$PUBLIC_GOOGLE_ADS_LEAD_LABEL \
    PUBLIC_GOOGLE_ADS_CHECKOUT_LABEL=$PUBLIC_GOOGLE_ADS_CHECKOUT_LABEL \
    PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=$PUBLIC_GOOGLE_ADS_PURCHASE_LABEL \
    PUBLIC_CLARITY_PROJECT_ID=$PUBLIC_CLARITY_PROJECT_ID \
    PUBLIC_GOOGLE_MAPS_API_KEY=$PUBLIC_GOOGLE_MAPS_API_KEY
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/web/kundaliweb/node_modules ./packages/web/kundaliweb/node_modules
COPY . .
RUN cd packages/web/kundaliweb && npx astro build

FROM node:20-slim AS runtime
RUN npm install -g serve@14
WORKDIR /app
COPY --from=build /app/packages/web/kundaliweb/dist ./dist
EXPOSE 3000
CMD ["serve", "dist", "-l", "3000"]
