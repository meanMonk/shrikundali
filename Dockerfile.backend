FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
# Skip puppeteer's own Chromium download at install time too — the runtime
# stage installs system chromium and points PUPPETEER_EXECUTABLE_PATH at it.
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/backend/kundaliapi/package.json ./packages/backend/kundaliapi/
RUN pnpm install --shamefully-hoist

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN cd packages/backend/kundaliapi && npx tsc

FROM node:20-slim AS runtime
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
# fonts-noto-core + fonts-noto-extra carry Devanagari (Hindi/Marathi), Tamil,
# Telugu, Gujarati, Bengali and other Indic script glyphs. Without these,
# Chromium has no matching glyphs and non-Latin report text renders as tofu
# boxes / blank space.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-noto-core \
    fonts-noto-extra \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/packages/backend/kundaliapi/dist ./dist
COPY --from=build /app/packages/backend/kundaliapi/package.json ./
COPY --from=build /app/assets ./assets
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
EXPOSE 3400
CMD ["node", "dist/index.js"]
